@page "/settings"
@page "/account/settings"
@attribute [AllowAnonymous]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject PoTrafficApiClient Api
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IWebAssemblyHostEnvironment HostEnvironment

<PageTitle>Settings · PoTraffic</PageTitle>

<PageHeader Title="Settings" BackHref="/dashboard" BackLabel="Commutes" />

@*  /settings — where the Po header's gear points, signed in or out (/account/settings is the
    old address, kept as an alias). Anonymous on purpose: it states that the theme follows the
    device and shows the build stamp to anyone. Signed in, it is also the account menu (email,
    Admin, sign out) and the home of every per-account setting.

    Common settings first, everything niche behind one "Advanced" disclosure. Your data stays
    last and always visible — export and delete are rare, but must never be hidden.

    Each section is its own component and error boundary, so one that throws (a bad
    quota payload, say) leaves the rest of the page usable. The wrapper div carries this
    page's CSS scope; the stylesheet reaches into the section components with ::deep. *@
<div class="pt-settings">
<RadzenCard class="pt-card-pad">
    <SectionErrorBoundary Label="the appearance settings">
    <section class="pt-settings-section">
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-3 pt-section-heading">Appearance</RadzenText>
        <div class="pt-settings-grid">
            <div>
                <span class="pt-settings-field-label">Theme</span>
                @* No switch: every Po app follows the device's light/dark setting. *@
                <p class="pt-settings-value" data-testid="settings-theme">
                    Follows your device (@(_prefersDark ? "dark" : "light") right now).
                </p>
            </div>
            <div>
                <span class="pt-settings-field-label">Build</span>
                <p class="pt-settings-value" data-testid="settings-build">@(BuildVersion.Stamp ?? "unknown")</p>
            </div>
        </div>

        @* Neither of these is ours to set — the OS owns them. Reporting them explains
           why the app already looks different. The OS motion preference is a floor:
           the Motion setting can never force animation back up past it. *@
        @if (_prefersContrast || _prefersReducedMotion)
        {
            <p class="pt-settings-meta pt-mt-3">Following your device: @DevicePreferences.</p>
        }
    </section>
    </SectionErrorBoundary>

    <section class="pt-settings-section" data-testid="settings-account">
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-3 pt-section-heading">Account</RadzenText>
        @if (_id.IsAuthenticated)
        {
            <div class="pt-settings-grid">
                <div>
                    @* The sign-in address can't be changed here, so it is text, not a
                       read-only box that looks editable. *@
                    <span class="pt-settings-field-label">Signed in as</span>
                    <p class="pt-settings-value">@_id.Email</p>
                </div>
                <div class="pt-settings-links">
                    @if (_id.IsAdmin)
                    {
                        <a class="pt-settings-link" href="/admin"><PtIcon Name="admin_panel_settings" Size="sm" />Admin</a>
                    }
                    <a class="pt-settings-link pt-settings-link-danger" href="/login" @onclick="SignOutAsync" @onclick:preventDefault="true"
                       data-testid="settings-signout"><PtIcon Name="logout" Size="sm" />Sign out</a>
                </div>
            </div>
            @if (!HostEnvironment.IsProduction())
            {
                @* Dev-only fake personas (X-Fake-User). They used to sit in the header's
                   account dropdown; the Po header carries only the email and the gear. *@
                <div class="pt-settings-links pt-mt-3">
                    <RadzenButton class="pt-plain pt-settings-link" Click='() => SwitchFakeUserAsync("dev-commuter@potraffic.dev", "Commuter")'><PtIcon Name="person" Size="sm" />Dev: Commuter</RadzenButton>
                    <RadzenButton class="pt-plain pt-settings-link" Click='() => SwitchFakeUserAsync("dev-admin@potraffic.dev", "Administrator")'><PtIcon Name="admin_panel_settings" Size="sm" />Dev: Admin</RadzenButton>
                    <RadzenButton class="pt-plain pt-settings-link" Click="() => SwitchFakeUserAsync(null, null)"><PtIcon Name="person_off" Size="sm" />Clear dev user</RadzenButton>
                </div>
            }
        }
        else if (_authResolved)
        {
            <p class="pt-settings-meta">You're not signed in.</p>
            <a class="pt-settings-link" href="/login"><PtIcon Name="login" Size="sm" />Sign in</a>
        }
    </section>

    @if (_id.IsAuthenticated)
    {
        <SectionErrorBoundary Label="this device's settings">
            <DeviceSettingsSection />
        </SectionErrorBoundary>

        <AdvancedSettingsSection Profile="_profile" Quota="_quota" Loading="_loading"
                                 Density="@_density" DensityChanged="OnDensityChanged"
                                 ProfileChanged="@(p => _profile = p)" />

        <SectionErrorBoundary Label="your data controls">
            <AccountDataSection />
        </SectionErrorBoundary>
    }
</RadzenCard>
</div>

@code {
    private ProfileDto? _profile;
    private QuotaDto? _quota;
    private bool _loading = true;
    private bool _authResolved;
    private AccountMenu.Identity _id = AccountMenu.Describe(new System.Security.Claims.ClaimsPrincipal());

    private string _density = "normal";
    private bool _prefersDark;
    private bool _prefersContrast;
    private bool _prefersReducedMotion;
    private IJSObjectReference? _appearance;

    protected override async Task OnInitializedAsync()
    {
        _id = AccountMenu.Describe((await AuthStateProvider.GetAuthenticationStateAsync()).User);
        _authResolved = true;
        if (!_id.IsAuthenticated)
        {
            _loading = false;
            return;
        }

        try
        {
            _profile = await Api.GetProfileAsync();
            _quota = await Api.GetQuotaAsync();
        }
        catch { /* handled by null guards */ }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _appearance = await JS.InvokeAsync<IJSObjectReference>("import", "./js/po-appearance.js");
            AppearanceState state = await _appearance.InvokeAsync<AppearanceState>("getAppearance");
            _density = state.Density;
            _prefersDark = state.PrefersDark;
            _prefersContrast = state.PrefersContrast;
            _prefersReducedMotion = state.PrefersReducedMotion;
            StateHasChanged();
        }
        catch
        {
            // No interop is a degraded settings panel, not a broken page — the
            // controls simply show the defaults.
        }
    }

    private async Task OnDensityChanged(string density)
    {
        _density = density;
        if (_appearance is not null)
            await _appearance.InvokeVoidAsync("setDensity", density);
    }

    private Task SignOutAsync() => AccountMenu.SignOutAsync(AuthStateProvider, Nav);

    /// <summary>Dev only: pins (or clears) the X-Fake-User persona the API client sends.</summary>
    private async Task SwitchFakeUserAsync(string? email, string? roles)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(email))
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", DevFakeUserHandler.FakeUserStorageKey);
                await JS.InvokeVoidAsync("localStorage.removeItem", DevFakeUserHandler.FakeRolesStorageKey);
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.setItem", DevFakeUserHandler.FakeUserStorageKey, email);
                await JS.InvokeVoidAsync("localStorage.setItem", DevFakeUserHandler.FakeRolesStorageKey, roles ?? "Commuter");
            }
        }
        catch (JSException)
        {
            // Private mode: the persona simply doesn't stick.
        }

        if (AuthStateProvider is Services.Auth.CookieAuthenticationStateProvider cookie)
            cookie.Refresh();
        _id = AccountMenu.Describe((await AuthStateProvider.GetAuthenticationStateAsync()).User);
    }

    /// <summary>"higher contrast and reduced motion (…)" — whichever the OS is asking for.</summary>
    private string DevicePreferences => string.Join(" and ", new[]
    {
        _prefersContrast ? "higher contrast" : null,
        _prefersReducedMotion ? "reduced motion, so animation stays off whatever Motion is set to" : null,
    }.Where(p => p is not null));

    /// <summary>Shape returned by <c>getAppearance</c> in po-appearance.js.</summary>
    private sealed record AppearanceState(
        string Density,
        bool PrefersDark,
        bool PrefersContrast,
        bool PrefersReducedMotion);

    public async ValueTask DisposeAsync()
    {
        if (_appearance is not null)
        {
            try { await _appearance.DisposeAsync(); } catch { /* page tearing down */ }
        }
    }
}
