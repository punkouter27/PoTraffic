@implements IAsyncDisposable
@inject IJSRuntime JS

@* ──────────────────────────────────────────────────────────────────────
   PtDialog — a native modal <dialog>, as a centred panel or a slide-out drawer.

   Native on purpose. showModal() gives, for free, everything a hand-rolled overlay
   kept getting wrong: the page behind goes inert, focus moves inside on open and
   returns to the opener on close, and Esc closes it. pt-keys.js reports every close
   (Esc, backdrop, the close button) back here, so Open can never disagree with the
   element.

   Knows nothing about the domain: a title, a body and an optional footer.

   One caveat that follows from being in the top layer: Radzen toasts and dialogs
   render underneath an open PtDialog, so report results inside it, or close it first.
   ────────────────────────────────────────────────────────────────────── *@

<dialog @ref="_dialog" class="pt-dialog @(Drawer ? "pt-dialog-drawer" : "pt-dialog-center") @Class"
        aria-labelledby="@_titleId">
    @* Always rendered: a closed <dialog> is display:none already, and keeping the content
       means the exit transition slides a full panel out rather than an empty one. *@
    <div class="pt-dialog-head">
        <h2 class="pt-dialog-title" id="@_titleId">@Title</h2>
        <button type="button" class="pt-dialog-close pt-tap" aria-label="Close" @onclick="CloseAsync">
            <PtIcon Name="close" Size="sm" />
        </button>
    </div>
    <div class="pt-dialog-body">
        @ChildContent
    </div>
    @if (Footer is not null)
    {
        <div class="pt-dialog-foot">@Footer</div>
    }
</dialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Slides in from the inline end, full height, instead of centring.</summary>
    [Parameter] public bool Drawer { get; set; }

    [Parameter] public string? Class { get; set; }

    private readonly string _titleId = $"pt-dialog-{Guid.NewGuid():N}";
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private IJSObjectReference? _binding;
    private DotNetObjectReference<PtDialog>? _self;
    private bool _shown;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;

        try
        {
            if (firstRender)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pt-keys.js");
                _self = DotNetObjectReference.Create(this);
                _binding = await _module.InvokeAsync<IJSObjectReference>("bindDialog", _dialog, _self);
            }

            // Synced after render so the content is in the DOM before showModal()
            // looks for something to focus.
            if (_module is not null && Open != _shown)
            {
                _shown = Open;
                await _module.InvokeVoidAsync(Open ? "showDialog" : "closeDialog", _dialog);
            }
        }
        catch (JSDisconnectedException) { /* page tearing down */ }
        catch (JSException) { /* no dialog support — the content is still reachable */ }
    }

    /// <summary>Raised by pt-keys.js for every close, whatever caused it.</summary>
    [JSInvokable]
    public async Task OnDialogClosed()
    {
        _shown = false;
        if (!Open)
            return;

        Open = false;
        await OpenChanged.InvokeAsync(false);
        StateHasChanged();
    }

    private async Task CloseAsync()
    {
        if (_module is not null)
        {
            // The close event comes back through OnDialogClosed.
            try { await _module.InvokeVoidAsync("closeDialog", _dialog); return; }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        }
        await OnDialogClosed();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_binding is not null)
            {
                await _binding.InvokeVoidAsync("dispose");
                await _binding.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { /* page already gone */ }
        catch (JSException) { /* module already gone */ }
        _self?.Dispose();
    }
}
