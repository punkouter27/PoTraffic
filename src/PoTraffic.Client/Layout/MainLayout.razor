@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav

@* Radzen service host components — must be present exactly once in the root layout *@
<RadzenNotification />
<RadzenDialog />
<RadzenTooltip />

@* First tab stop skips the nav straight to the page's own content. *@
<a class="skip-link" href="#main-content">Skip to main content</a>

@* The app's ONE layout (AGENTS.md, Components). The sign-in page (/login) gets the same shell in
   its sign-in form: the header shows the app title only and the page is one centred card with the
   title and the one sign-in button. *@
<div class="page">
    @* Po shell header: app name, email or Sign in, settings gear (Po web standard). *@
    <PoHeader TitleOnly="@IsSignInPage" />

    @if (IsSignInPage)
    {
        <main class="auth-shell" id="main-content" tabindex="-1">
            <div class="auth-card">
                <SectionErrorBoundary @ref="_pageBoundary" Label="the sign-in form">
                    @Body
                </SectionErrorBoundary>
            </div>
        </main>
        <BuildVersion />
    }
    else
    {
        <main id="main-content" tabindex="-1">
            <article class="content">
                @* Page-level containment: a page that throws keeps the shell and gets a
                   Retry. Its own sections carry their own boundaries inside this one. *@
                <SectionErrorBoundary @ref="_pageBoundary" Label="this page">
                    @Body
                </SectionErrorBoundary>
                @* Build stamp vYYMMDD (AGENTS.md standing requirement): fixed bottom-right on wide
                   screens; on phones po-tokens.css makes it static, so it sits after the page
                   content and above the bottom nav's reserved space. Keep it here. *@
                <BuildVersion />
            </article>
        </main>

        @* Every bottom-nav destination needs an account, so signed-out visitors don't get the bar. *@
        <AuthorizeView>
            <Authorized>
                <BottomNav />
            </Authorized>
        </AuthorizeView>
    }
</div>

@* Global overlay — one instance, above the page so it survives navigation.
   The command palette used to live here too. It was removed: a Ctrl+K launcher
   and a fuzzy matcher are a lot of machinery for an app with three destinations
   and a bottom nav. What survives is four single-key shortcuts (below), each a
   faster path to a control that is already on screen. *@
<UndoBar />

@* Registers the service worker on first render, then offers the reload when a newer
   build is downloaded and waiting. In the layout so it happens once per session and
   the notice is not lost by navigating. *@
<PwaUpdateBar />

@* "/", "n", "c" and "?" — see KeyboardShortcuts for how pages opt in. *@
<KeyboardShortcuts />



@code {
    private SectionErrorBoundary? _pageBoundary;

    /// <summary>The sign-in page: title-only header, one centred card, no bottom nav.</summary>
    private bool IsSignInPage => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0]
        .Equals("login", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    /// <summary>A failed page must not stay failed once the user has gone somewhere else.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(() => _pageBoundary?.Recover());

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
