###############################################################################
# PoTraffic API — requests for the VS Code REST Client / Visual Studio .http runner.
#
# Sign-in is a cookie (BFF); there is no bearer token. Outside Production the X-Fake-User
# header authenticates a request as that user (X-Fake-Roles: Administrator for admin
# routes), which is what every request below uses. Run against the Development host.
###############################################################################

@host = https://localhost:5001
@user = dev@potraffic.local
@routeId = 00000000-0000-0000-0000-000000000000
@windowId = 00000000-0000-0000-0000-000000000000

### ── Health (anonymous) ───────────────────────────────────────────────────────
GET {{host}}/health/live

###
GET {{host}}/health/ready

###
GET {{host}}/health/json

###
GET {{host}}/health/connections

### ── Auth ─────────────────────────────────────────────────────────────────────
GET {{host}}/api/auth/providers

###
GET {{host}}/api/auth/me
X-Fake-User: {{user}}

###
# Development and Testing only: a fresh GUEST account and session cookie.
POST {{host}}/api/auth/guest-login

### ── Config (anonymous) ───────────────────────────────────────────────────────
GET {{host}}/api/system/features

### ── Account ──────────────────────────────────────────────────────────────────
GET {{host}}/api/account/profile
X-Fake-User: {{user}}

###
PUT {{host}}/api/account/profile
X-Fake-User: {{user}}
Content-Type: application/json

{ "locale": "en-US" }

###
PUT {{host}}/api/account/timezone
X-Fake-User: {{user}}
Content-Type: application/json

{ "timeZoneId": "America/New_York" }

###
GET {{host}}/api/account/quota
X-Fake-User: {{user}}

###
GET {{host}}/api/account/export
X-Fake-User: {{user}}

###
DELETE {{host}}/api/account/
X-Fake-User: {{user}}

### ── Routes ───────────────────────────────────────────────────────────────────
GET {{host}}/api/routes?page=1&pageSize=20
X-Fake-User: {{user}}

###
POST {{host}}/api/routes
X-Fake-User: {{user}}
Content-Type: application/json

{
  "originAddress": "123 Main St, New York, NY 10001",
  "destinationAddress": "456 Broadway, New York, NY 10002",
  "provider": 0,
  "startTime": "08:00",
  "endTime": "09:00",
  "daysOfWeekMask": 31
}

###
POST {{host}}/api/routes/sample
X-Fake-User: {{user}}
Content-Type: application/json

{ "utcOffsetMinutes": 0 }

###
GET {{host}}/api/routes/{{routeId}}
X-Fake-User: {{user}}

###
DELETE {{host}}/api/routes/{{routeId}}
X-Fake-User: {{user}}

###
POST {{host}}/api/routes/{{routeId}}/check-now
X-Fake-User: {{user}}

###
POST {{host}}/api/routes/{{routeId}}/return-trip
X-Fake-User: {{user}}

###
GET {{host}}/api/routes/{{routeId}}/path
X-Fake-User: {{user}}

###
PUT {{host}}/api/routes/{{routeId}}/name
X-Fake-User: {{user}}
Content-Type: application/json

{ "name": "School run" }

###
PUT {{host}}/api/routes/{{routeId}}/arrive-by
X-Fake-User: {{user}}
Content-Type: application/json

{ "arriveBy": "08:45" }

###
PUT {{host}}/api/routes/{{routeId}}/addresses
X-Fake-User: {{user}}
Content-Type: application/json

{ "originAddress": "123 Main St, New York, NY 10001", "destinationAddress": "1 Wall St, New York, NY 10005" }

###
PUT {{host}}/api/routes/{{routeId}}/paused
X-Fake-User: {{user}}
Content-Type: application/json

{ "paused": true }

### ── Monitoring windows ───────────────────────────────────────────────────────
# Windows are read off GET /api/routes/{id}; edit one by POSTing with replacesWindowId.
POST {{host}}/api/routes/{{routeId}}/windows
X-Fake-User: {{user}}
Content-Type: application/json

{ "startTime": "07:00", "endTime": "09:00", "daysOfWeekMask": 31 }

###
POST {{host}}/api/routes/{{routeId}}/windows/{{windowId}}/start
X-Fake-User: {{user}}

###
POST {{host}}/api/routes/{{routeId}}/windows/{{windowId}}/stop
X-Fake-User: {{user}}
Content-Type: application/json

{ "sessionId": "00000000-0000-0000-0000-000000000000" }

### ── History ──────────────────────────────────────────────────────────────────
GET {{host}}/api/routes/{{routeId}}/poll-history?page=1&pageSize=50
X-Fake-User: {{user}}

###
GET {{host}}/api/routes/{{routeId}}/sessions
X-Fake-User: {{user}}

###
GET {{host}}/api/routes/{{routeId}}/departure?dayOfWeek=Monday
X-Fake-User: {{user}}

###
GET {{host}}/api/routes/{{routeId}}/heatmap
X-Fake-User: {{user}}

###
GET {{host}}/api/routes/{{routeId}}/weather-impact
X-Fake-User: {{user}}

### ── Places ───────────────────────────────────────────────────────────────────
GET {{host}}/api/places/autocomplete?q=1600%20Amph
X-Fake-User: {{user}}

### ── Alerts and push ──────────────────────────────────────────────────────────
GET {{host}}/api/alerts?unreadOnly=true
X-Fake-User: {{user}}

###
POST {{host}}/api/alerts/read-all
X-Fake-User: {{user}}

###
GET {{host}}/api/push/key
X-Fake-User: {{user}}

### ── Admin (Administrator role) ───────────────────────────────────────────────
GET {{host}}/api/admin/users
X-Fake-User: {{user}}
X-Fake-Roles: Administrator

###
PUT {{host}}/api/admin/users/00000000-0000-0000-0000-000000000000/daily-quota
X-Fake-User: {{user}}
X-Fake-Roles: Administrator
Content-Type: application/json

{ "dailySessionQuota": 20 }

###
GET {{host}}/api/admin/configuration
X-Fake-User: {{user}}
X-Fake-Roles: Administrator

###
# Editable keys: cost.*, cost.monthly.cap.usd, quota.daily.default,
# feature.mockproviders.enabled, feature.weather.enabled. Takes effect without a restart.
PUT {{host}}/api/admin/configuration/feature.weather.enabled
X-Fake-User: {{user}}
X-Fake-Roles: Administrator
Content-Type: application/json

{ "value": "true" }

###
GET {{host}}/api/admin/spending
X-Fake-User: {{user}}
X-Fake-Roles: Administrator

###
GET {{host}}/api/admin/global-volatility/recent?hours=24
X-Fake-User: {{user}}
X-Fake-Roles: Administrator

### ── Diagnostics (Administrator role) ─────────────────────────────────────────
GET {{host}}/diag/keyvault?secret=GoogleMaps:ApiKey
X-Fake-User: {{user}}
X-Fake-Roles: Administrator
