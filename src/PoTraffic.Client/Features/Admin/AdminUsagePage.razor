@page "/admin"
@attribute [Authorize(Roles = "Administrator")]
@inject HttpClient Http

<PageTitle>Admin — PoTraffic</PageTitle>

@* Dependency health is not repeated here as a tab: /health is that page, and the tab
   called an admin endpoint that was never mapped, so it only ever showed an error. *@
<PageHeader Title="Admin" Subtitle="User consumption, fleet-wide volatility and system configuration.">
    <Actions>
        <RadzenLink Path="/health" Text="System status" Icon="health_and_safety" />
    </Actions>
</PageHeader>

<RadzenCard class="pt-p-6">
    <RadzenTabs>
        <Tabs>
            <RadzenTabsItem Text="Usage Insights" Icon="people">
                <RadzenText TextStyle="TextStyle.H3" class="pt-mb-2 pt-mt-3 pt-section-heading">Daily Usage</RadzenText>
                <LoadingErrorCard IsLoading="_loading" Error="@_error">
                    @* Virtualized rather than paged.

                       The endpoint returns every user in one payload, so paging was
                       only ever hiding rows that had already been downloaded and
                       parsed — it bounded the DOM but not the work. Virtualization
                       bounds the DOM too, and replaces "which of 14 pages was that
                       user on" with a scrollbar. Radzen needs an explicit height to
                       virtualize against, hence Style. *@
                    <div class="pt-admin-wide">
                    <RadzenDataGrid Data="_users" TItem="UserDailyUsageDto"
                                    AllowSorting="true" AllowFiltering="true"
                                    AllowVirtualization="true"
                                    Style="height: 32rem"
                                    Density="Density.Compact"
                                    AllowColumnResize="true"
                                    AllowColumnReorder="true"
                                    AllowColumnPicking="true"
                                    ColumnWidth="10rem"
                                    FilterMode="FilterMode.Simple"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    EmptyText="No users have signed in yet."
                                    class="pt-mt-2">
                        <Columns>
                            <RadzenDataGridColumn TItem="UserDailyUsageDto" Property="Email" Title="Email" MinWidth="12rem" />
                            <RadzenDataGridColumn TItem="UserDailyUsageDto" Property="Locale" Title="Locale" Width="7rem" />
                            <RadzenDataGridColumn TItem="UserDailyUsageDto" Property="TodayPollCount" Title="Polls Today" Width="9rem" />
                            <RadzenDataGridColumn TItem="UserDailyUsageDto" Property="TodayEstimatedCostUsd" Title="Est. Cost (USD)" Width="10rem">
                                <Template Context="u">
                                    @u.TodayEstimatedCostUsd.ToString("C4")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="UserDailyUsageDto" Property="LastLoginAt" Title="Last Login" Width="11rem">
                                <Template Context="u">
                                    @(u.LastLoginAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                    </div>

                    @* Phones get cards, not a grid (#23): five columns of a virtualized grid in
                       a 360px viewport meant scrolling sideways to find a user's cost. Same rows,
                       same order, one card per user; the grid above is hidden at this width. *@
                    <ul class="pt-admin-cards" aria-label="Daily usage">
                        @if (_users.Count == 0)
                        {
                            <li class="pt-admin-card-empty">No users have signed in yet.</li>
                        }
                        @foreach (UserDailyUsageDto u in _users)
                        {
                            <li class="pt-admin-card">
                                <div class="pt-admin-card-title">@u.Email</div>
                                <dl class="pt-admin-card-fields">
                                    <dt>Polls today</dt><dd>@u.TodayPollCount</dd>
                                    <dt>Est. cost</dt><dd>@u.TodayEstimatedCostUsd.ToString("C4")</dd>
                                    <dt>Locale</dt><dd>@u.Locale</dd>
                                    <dt>Last login</dt><dd>@(u.LastLoginAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                                </dl>
                            </li>
                        }
                    </ul>
                </LoadingErrorCard>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Global Volatility" Icon="analytics">
                <RadzenText TextStyle="TextStyle.Caption" class="pt-mt-3 pt-mb-4">Mean travel time across all active routes — past 24 hours</RadzenText>
                <LoadingErrorCard IsLoading="_volLoading" Error="@_volError">
                    @if (_points.Count == 0 && !_volLoading)
                    {
                        <div class="pt-empty-state pt-empty-state-inline">
                            <PtIcon Name="show_chart" Size="xl" Class="pt-empty-state-icon" />
                            <div class="pt-empty-state-title">No volatility data</div>
                            <div class="pt-empty-state-text">
                                Nothing was sampled across any active route in the past 24 hours.
                            </div>
                        </div>
                    }
                    else
                    {
                        <RadzenChart class="pt-admin-chart">
                            <RadzenLineSeries Data="_series" CategoryProperty="PolledAt"
                                              ValueProperty="Minutes" TItem="VolatilityPoint"
                                              Title="Mean travel time" Smooth="true"
                                              Stroke="var(--pt-color-brand-500)" StrokeWidth="2">
                                <ChildContent>
                                    <RadzenMarkers MarkerType="MarkerType.None" />
                                </ChildContent>
                                <TooltipTemplate Context="p">
                                    <div>@p.Minutes.ToString("F1") min · @p.RouteCount route(s)</div>
                                </TooltipTemplate>
                            </RadzenLineSeries>
                            <RadzenCategoryAxis FormatString="{0:HH:mm}" />
                            <RadzenValueAxis>
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="Minutes" />
                            </RadzenValueAxis>
                        </RadzenChart>
                    }
                </LoadingErrorCard>
            </RadzenTabsItem>

            <RadzenTabsItem Text="System Config" Icon="settings">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="pt-mt-3 pt-mb-4 pt-diag-subtitle">
                    Sensitive values are masked. Values can be updated by administrators.
                </RadzenText>
                <LoadingErrorCard IsLoading="_cfgLoading" Error="@_cfgError">
                    <div class="pt-admin-wide">
                    <RadzenDataGrid Data="_configs" TItem="SystemConfigDto" AllowSorting="true"
                                    AllowFiltering="true" FilterMode="FilterMode.Simple"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Density="Density.Compact" AllowColumnResize="true"
                                    AllowColumnPicking="true"
                                    EmptyText="No configuration entries."
                                    class="pt-mt-2">
                        <Columns>
                            <RadzenDataGridColumn TItem="SystemConfigDto" Property="Key" Title="Key" Width="14rem" />
                            <RadzenDataGridColumn TItem="SystemConfigDto" Property="Value" Title="Value" Width="13rem">
                                <Template Context="c">
                                    @if (c.IsSensitive)
                                    {
                                        <span class="pt-diag-sensitive">@c.Value</span>
                                    }
                                    else
                                    {
                                        @c.Value
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="SystemConfigDto" Property="Description" Title="Description" />
                            <RadzenDataGridColumn TItem="SystemConfigDto" Title="Sensitive" Width="90px">
                                <Template Context="c">
                                    @if (c.IsSensitive)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Yes" />
                                    }
                                    else
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="No" />
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                    </div>

                    @* Phone layout — see the usage tab. Values wrap rather than truncate: a
                       config value cut off at the card edge is a value nobody can read. *@
                    <ul class="pt-admin-cards" aria-label="System configuration">
                        @if (_configs.Count == 0)
                        {
                            <li class="pt-admin-card-empty">No configuration entries.</li>
                        }
                        @foreach (SystemConfigDto c in _configs)
                        {
                            <li class="pt-admin-card">
                                <div class="pt-admin-card-title">
                                    @c.Key
                                    @if (c.IsSensitive)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Sensitive" />
                                    }
                                </div>
                                <div class="pt-admin-card-value @(c.IsSensitive ? "pt-diag-sensitive" : "")">@c.Value</div>
                                @if (!string.IsNullOrEmpty(c.Description))
                                {
                                    <div class="pt-admin-card-desc">@c.Description</div>
                                }
                            </li>
                        }
                    </ul>
                </LoadingErrorCard>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenCard>

@code {
    // ── Usage tab ──────────────────────────────────────────────────────────────
    private List<UserDailyUsageDto> _users = [];
    private bool _loading = true;
    private string? _error;

    // ── Volatility tab ─────────────────────────────────────────────────────────
    private List<RecentVolatilityPointDto> _points = [];
    private bool _volLoading = true;
    private string? _volError;

    /// <summary>
    /// The wire DTO carries seconds; every other chart in the app plots minutes. Converted
    /// once here rather than in the series binding, so the axis and the tooltip cannot
    /// disagree about the unit again.
    /// </summary>
    private sealed record VolatilityPoint(DateTime PolledAt, double Minutes, int RouteCount);

    private List<VolatilityPoint> _series = [];

    // ── System Config tab ─────────────────────────────────────────────────────
    private List<SystemConfigDto> _configs = [];
    private bool _cfgLoading = true;
    private string? _cfgError;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadUsageAsync(), LoadVolatilityAsync(), LoadConfigAsync());
    }

    private async Task LoadUsageAsync()
    {
        try
        {
            _users = await Http.GetFromJsonAsync("/api/admin/users", AppJsonContext.Default.ListUserDailyUsageDto) ?? [];
        }
        catch (Exception ex)
        {
            _error = $"Failed to load usage data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadVolatilityAsync()
    {
        try
        {
            _points = await Http.GetFromJsonAsync(
                "/api/admin/global-volatility/recent?hours=24", AppJsonContext.Default.ListRecentVolatilityPointDto) ?? [];
            _series = [.. _points.Select(p =>
                // PolledAt is a UTC DateTimeOffset on the wire (RecentVolatilityPointDto.PolledAt).
                // Radzen's CategoryAxis treats DateTime as wall-clock and renders it as-is,
                // so we convert to local here — an Eastern user seeing 14:00 UTC reads 10:00.
                new VolatilityPoint(p.PolledAt.ToLocalTime().DateTime,
                    p.MeanDurationSeconds / 60.0, p.RouteCount))];
        }
        catch (Exception ex)
        {
            _volError = $"Failed to load volatility data: {ex.Message}";
        }
        finally
        {
            _volLoading = false;
        }
    }

    private async Task LoadConfigAsync()
    {
        try
        {
            _configs = await Http.GetFromJsonAsync("/api/admin/configuration", AppJsonContext.Default.ListSystemConfigDto) ?? [];
        }
        catch (Exception ex)
        {
            _cfgError = $"Failed to load configuration: {ex.Message}";
        }
        finally
        {
            _cfgLoading = false;
        }
    }
}
