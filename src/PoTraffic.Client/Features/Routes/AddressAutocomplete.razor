@using PoTraffic.Shared.DTOs.Routes
@implements IDisposable
@inject PoTrafficApiClient Api

@* #9 — debounced Google Places autocomplete (BFF-proxied). Degrades to a plain text box
   when the API returns nothing, so free-text entry always works. *@
<div class="pt-ac">
    <input class="pt-ac-input" type="text" value="@Value" placeholder="@Placeholder"
           aria-label="@AriaLabel" aria-invalid="@(Invalid ? "true" : null)"
           aria-autocomplete="list" aria-expanded="@(_open && _suggestions.Count > 0 ? "true" : "false")"
           @oninput="OnInput" @onblur="OnBlur" @onkeydown="OnKeyDown" autocomplete="off" />
    @if (_open && _suggestions.Count > 0)
    {
        <ul class="pt-ac-list" role="listbox">
            @foreach (PlaceSuggestionDto s in _suggestions)
            {
                <li class="pt-ac-item" role="option" aria-selected="false" @onmousedown="() => Pick(s)">@s.Description</li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;

    /// <summary>Accessible name; the visible label belongs to the RadzenFormField around it.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Marks the input invalid (aria-invalid and the error border) while a message is shown.</summary>
    [Parameter] public bool Invalid { get; set; }

    private List<PlaceSuggestionDto> _suggestions = [];
    private bool _open;
    private System.Timers.Timer? _debounce;
    private string _pending = string.Empty;
    private bool _disposed;

    private async Task OnInput(ChangeEventArgs e)
    {
        string text = e.Value?.ToString() ?? string.Empty;
        Value = text;
        await ValueChanged.InvokeAsync(text);

        _pending = text;
        _debounce?.Stop();
        _debounce ??= CreateTimer();
        _debounce.Start();
    }

    private System.Timers.Timer CreateTimer()
    {
        var t = new System.Timers.Timer(250) { AutoReset = false };
        // Elapsed runs on a timer thread and can fire after the component is gone (a
        // keystroke, then navigating away inside 250ms); InvokeAsync on a disposed
        // renderer throws, and that exception would land on the thread pool unobserved.
        t.Elapsed += async (_, _) =>
        {
            if (_disposed) return;
            try { await InvokeAsync(QueryAsync); }
            catch (ObjectDisposedException) { /* torn down mid-tick */ }
        };
        return t;
    }

    private async Task QueryAsync()
    {
        if (_disposed)
            return;
        string q = _pending;
        if (q.Trim().Length < 3)
        {
            _open = false;
            _suggestions = [];
            StateHasChanged();
            return;
        }
        try
        {
            List<PlaceSuggestionDto>? results = await Api.SearchPlacesAsync(q);
            _suggestions = results ?? [];
            _open = _suggestions.Count > 0;
        }
        catch
        {
            _suggestions = [];
            _open = false;
        }
        if (!_disposed)
            StateHasChanged();
    }

    private async Task Pick(PlaceSuggestionDto s)
    {
        Value = s.Description;
        _open = false;
        await ValueChanged.InvokeAsync(s.Description);
    }

    /// <summary>Escape closes the list, as a combobox should — it otherwise covered the button below.</summary>
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _open = false;
    }

    // Delay close so a mousedown on a suggestion still registers.
    private void OnBlur() => _open = false;

    public void Dispose()
    {
        _disposed = true;
        _debounce?.Stop();
        _debounce?.Dispose();
    }
}
