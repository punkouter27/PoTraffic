@page "/routes/create"
@attribute [Authorize]
@using FluentValidation
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.Enums
@using PoTraffic.Client.Features.MonitoringWindows
@inject PoTrafficApiClient Api
@inject NavigationManager Nav

<PageTitle>New commute · PoTraffic</PageTitle>

<div class="pt-create-route-card">
<PageHeader Title="New commute" BackHref="/dashboard" BackLabel="Commutes" />

<RadzenCard>
    @if (!string.IsNullOrEmpty(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="pt-mb-3 pt-enter">@_error</RadzenAlert>
    }

    <SectionErrorBoundary Label="the form">
    <RadzenTemplateForm TItem="CreateRouteForm" Data="@_form" Submit="@SaveAsync">
        <FluentValidationValidator TModel="CreateRouteForm" Validator="@_validator" />
        <RadzenFormField Text="From" class="pt-w-100 pt-mb-2">
            <ChildContent>
                <AddressAutocomplete @bind-Value="_form.OriginAddress"
                                     @bind-Value:after="() => _originError = null"
                                     Placeholder="e.g. Home or 1600 Amphitheatre Pkwy"
                                     AriaLabel="From" Invalid="@(_originError is not null)" />
            </ChildContent>
            <Helper>
                @if (_originError is not null)
                {
                    <div class="rz-message rz-messages-error" role="alert">@_originError</div>
                }
            </Helper>
        </RadzenFormField>

        <RadzenFormField Text="To" class="pt-w-100 pt-mb-3">
            <ChildContent>
                <AddressAutocomplete @bind-Value="_form.DestinationAddress"
                                     @bind-Value:after="() => _destinationError = null"
                                     Placeholder="e.g. Work or 1 Apple Park Way"
                                     AriaLabel="To" Invalid="@(_destinationError is not null)" />
            </ChildContent>
            <Helper>
                @if (_destinationError is not null)
                {
                    <div class="rz-message rz-messages-error" role="alert">@_destinationError</div>
                }
            </Helper>
        </RadzenFormField>

        <RadzenFormField Text="Arrive by (optional)" class="pt-mb-3">
            <RadzenDatePicker Name="ArriveBy" TValue="DateTime?" Value="_arriveByTime" ValueChanged="OnArriveByChanged"
                              ShowTime="true" TimeOnly="true" DateFormat="HH:mm" AllowClear="true"
                              aria-label="Time you need to arrive" />
        </RadzenFormField>

        <ScheduleFields @bind-Start="_startTime" @bind-End="_endTime" @bind-Days="_days" DaysError="@_daysError" />

        <div class="pt-form-actions pt-mt-4">
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save & start monitoring"
                          Icon="play_arrow" ButtonStyle="ButtonStyle.Primary"
                          IsBusy="_loading" Disabled="_loading" />
            <RadzenButton ButtonType="ButtonType.Button" Text="Cancel"
                          ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined"
                          Disabled="_loading" Click="@(() => Nav.NavigateTo("/dashboard"))" />
        </div>
    </RadzenTemplateForm>
    </SectionErrorBoundary>
</RadzenCard>
</div>

@code {
    public sealed class CreateRouteForm
    {
        public string OriginAddress { get; set; } = string.Empty;
        public string DestinationAddress { get; set; } = string.Empty;
        public byte DayMask { get; set; } = 0x1F;
    }

    private sealed class CreateRouteFormValidator : AbstractValidator<CreateRouteForm>
    {
        public CreateRouteFormValidator()
        {
            RuleFor(x => x.OriginAddress)
                .NotEmpty().WithMessage("Enter an origin address.")
                .MaximumLength(ValidationConstants.AddressMaxLength);
            RuleFor(x => x.DestinationAddress)
                .NotEmpty().WithMessage("Enter a destination address.")
                .MaximumLength(ValidationConstants.AddressMaxLength);
            RuleFor(x => x.DayMask)
                .Must(m => m != 0).WithMessage("Select at least one day to probe.");
        }
    }

    private readonly CreateRouteForm _form = new();
    private readonly CreateRouteFormValidator _validator = new();

    private string? _originError;
    private string? _destinationError;
    private string? _daysError;

    private DateTime? _startTime = ScheduleFields.DefaultWindow().Start;
    private DateTime? _endTime = ScheduleFields.DefaultWindow().End;
    private IEnumerable<byte> _days = ScheduleFields.DefaultDayBits;

    private string _error = "";
    private bool _loading;
    private readonly int _provider = (int)RouteProvider.GoogleMaps;

    private byte DayMask => ScheduleFields.ToMask(_days);

    private DateTime? _arriveByTime;
    private string? ArriveByHHmm => _arriveByTime is { } t ? ScheduleFields.ToHHmm(t) : null;

    private void OnArriveByChanged(DateTime? value)
    {
        _arriveByTime = value;
        if (value is not { } picked)
            return;

        DateTime end = DateTime.Today.Add(TimeOnly.FromDateTime(picked).ToTimeSpan());
        _endTime = end;
        _startTime = end.AddHours(-3);
    }

    private async Task SaveAsync()
    {
        if (_loading)
            return;

        _error = "";
        _originError = null;
        _destinationError = null;
        _daysError = null;

        _form.DayMask = DayMask;
        FluentValidation.Results.ValidationResult validation = _validator.Validate(_form);
        if (!validation.IsValid)
        {
            _originError = validation.Errors.FirstOrDefault(e => e.PropertyName == nameof(CreateRouteForm.OriginAddress))?.ErrorMessage;
            _destinationError = validation.Errors.FirstOrDefault(e => e.PropertyName == nameof(CreateRouteForm.DestinationAddress))?.ErrorMessage;
            _daysError = validation.Errors.FirstOrDefault(e => e.PropertyName == nameof(CreateRouteForm.DayMask))?.ErrorMessage;
            return;
        }

        if (_startTime is null || _endTime is null || !ScheduleFields.EndDiffersFromStart(_startTime, _endTime))
            return;

        _loading = true;
        try
        {
            HttpResponseMessage createResp = await Api.CreateRouteAsync(new CreateRouteRequest(
                _form.OriginAddress,
                _form.DestinationAddress,
                (RouteProvider)_provider,
                ScheduleFields.ToHHmm(_startTime!.Value),
                ScheduleFields.ToHHmm(_endTime!.Value),
                DayMask,
                ScheduleFields.LocalZoneId));

            if (!createResp.IsSuccessStatusCode)
            {
                if (createResp.StatusCode is System.Net.HttpStatusCode.Unauthorized
                                          or System.Net.HttpStatusCode.Forbidden)
                {
                    _error = "Your session has expired. Please sign in again.";
                    Nav.NavigateTo("/login?returnUrl=/routes/create");
                    return;
                }

                ProblemDetailsParser.ParsedError parsed = await ProblemDetailsParser.ParseAsync(
                    createResp,
                    "Failed to create commute. Please verify your addresses.");

                _error = parsed.ErrorCode switch
                {
                    RouteErrorCodes.MapsKeyMissing => "Maps integration is not configured on the server.",
                    RouteErrorCodes.AddressNotFound => "We couldn't find that address. Please check and try again.",
                    RouteErrorCodes.SameCoordinates => "Origin and destination resolve to the same location. Please use different addresses.",
                    _ when (int)createResp.StatusCode >= 500 => "Something went wrong on our end. Please try again in a moment.",
                    _ => parsed.Message
                };
                return;
            }

            RouteDto? createdRoute = await createResp.Content.ReadFromJsonAsync(AppJsonContext.Default.RouteDto);
            if (createdRoute is not null && ArriveByHHmm is not null)
            {
                try
                {
                    await Api.SetArriveByAsync(createdRoute.Id, ArriveByHHmm);
                }
                catch { }
            }
            MonitoringWindowDto? activeWindow = createdRoute?.Windows.FirstOrDefault(w => w.IsActive);

            if (createdRoute is null || activeWindow is null)
            {
                _error = "Commute was created, but monitoring window could not be initialized.";
                Nav.NavigateTo("/dashboard");
                return;
            }

            HttpResponseMessage startResp = await Api.StartWindowAsync(createdRoute.Id, activeWindow.Id);

            if (startResp.IsSuccessStatusCode)
            {
                Nav.NavigateTo($"/routes/{createdRoute.Id}");
                return;
            }

            _error = startResp.StatusCode == System.Net.HttpStatusCode.TooManyRequests
                ? "Commute created, but daily quota is exhausted. Monitoring can start tomorrow."
                : "Commute created, but automatic start failed. You can start monitoring from the commute page.";

            Nav.NavigateTo($"/routes/{createdRoute.Id}");
        }
        catch
        {
            _error = "Unable to connect. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
