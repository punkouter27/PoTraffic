<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoTraffic.Mobile.Pages.AlertsPage"
             Title="Alerts">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Volatility &amp; Reroute Alerts" FontSize="22" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10">
                <Button Text="Refresh" Clicked="OnRefreshClicked" />
                <Button Text="Mark All Read" Clicked="OnMarkReadClicked" />
            </HorizontalStackLayout>
            <Label x:Name="StatusLabel" FontSize="12" />
            <VerticalStackLayout x:Name="AlertsList" Spacing="8" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
