@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.DTOs.Routes

@* The route page's answer: "Leave by" whenever there is a plan, because that is the
   question the app exists to answer; the day's range of durations is the supporting line. *@
<section class="pt-answer" aria-label="Route summary">
    @* The title already reads "Origin → Destination" unless the route is named. *@
    @if (Route.Name is not null)
    {
        <div class="pt-answer-route">
            <span class="pt-answer-from">@OriginStreet</span>
            <PtIcon Name="arrow_right_alt" Size="sm" Class="pt-answer-arrow" />
            <span class="pt-answer-to">@DestinationStreet</span>
        </div>
    }

    @if (Plan is { LeaveBy: { } leaveBy } plan)
    {
        <div class="pt-answer-headline">Leave by @LocalTimeFormatter.FormatWallClock(leaveBy)</div>
        <div class="pt-answer-meta">
            On time on @plan.OnTimePercent% of @plan.SampleCount recorded trips —
            usually @TextFormatting.Minutes(plan.TypicalSeconds ?? 0) min, up to @TextFormatting.Minutes(plan.WorstCaseSeconds ?? 0) min.
            @if (!plan.DayOfWeekSpecific)
            {
                <span>Based on every day until today's history fills in.</span>
            }
        </div>
    }
    else if (TodayPolls.Count == 0)
    {
        <div class="pt-answer-headline pt-answer-pending">Still learning this commute</div>
        <div class="pt-answer-duration">@_pendingDetail</div>
    }
    else
    {
        <div class="pt-answer-headline">@_durationLabel</div>
    }

    @if (Plan is { LeaveBy: null })
    {
        <div class="pt-answer-meta">
            Not enough trips in the three hours before @LocalTimeFormatter.FormatWallClock(Plan.ArriveBy)
            to plan a departure yet — the monitoring window needs to cover when you'd leave.
        </div>
    }

    @if (TodayPolls.Count > 0 && Plan is { LeaveBy: not null })
    {
        <div class="pt-answer-meta">@_durationLabel</div>
    }

    @if (TodayPolls.LastOrDefault()?.HolidayName is { } holiday)
    {
        <div class="pt-answer-meta">
            Today is @holiday — its trips are shown here but don't count toward your usual times.
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public RouteDto Route { get; set; } = default!;

    /// <summary>Title-cased first line of the origin address.</summary>
    [Parameter] public string OriginStreet { get; set; } = string.Empty;

    [Parameter] public string DestinationStreet { get; set; } = string.Empty;

    [Parameter] public DeparturePlanDto? Plan { get; set; }

    /// <summary>Today's samples, oldest first.</summary>
    [Parameter] public IReadOnlyList<PollRecordDto> TodayPolls { get; set; } = [];

    private string _durationLabel = string.Empty;
    private string _pendingDetail = string.Empty;

    /// <summary>
    /// Formats the duration line: the fastest and slowest of today's samples. It is the
    /// headline only until an arrive-by target yields a plan.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (TodayPolls.Count == 0)
        {
            _pendingDetail = TextFormatting.SamplesSoFar(0);
            return;
        }

        _durationLabel = TextFormatting.MinuteRange(
            TodayPolls.Min(p => p.TravelDurationSeconds),
            TodayPolls.Max(p => p.TravelDurationSeconds)) + " today";
    }
}
