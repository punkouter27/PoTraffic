@implements IDisposable
@inject DialogService Dialogs

@* ──────────────────────────────────────────────────────────────────────
   PtDialog — a Radzen dialog (DialogService), as a centred panel or a side drawer.

   Every control is a Radzen component (AGENTS.md, Components), so this is a thin
   bridge from the old Open/OpenChanged parameters to DialogService: Open=true opens
   it (OpenAsync, or OpenSideAsync for a drawer), every close (Esc, the overlay, the
   title-bar close button) flows back through OpenChanged, and a parent re-render
   refreshes the open dialog so its content keeps up with the parent's state.

   Knows nothing about the domain: a title, a body and an optional footer.
   ────────────────────────────────────────────────────────────────────── *@

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Slides in from the inline end, full height, instead of centring.</summary>
    [Parameter] public bool Drawer { get; set; }

    [Parameter] public string? Class { get; set; }

    private bool _shown;
    private bool _closingFromHere;

    protected override void OnParametersSet()
    {
        if (Open && !_shown)
        {
            _shown = true;
            _ = ShowAsync();
        }
        else if (!Open && _shown)
        {
            _closingFromHere = true;
            if (Drawer)
                Dialogs.CloseSide();
            else
                Dialogs.Close();
        }
        else if (_shown)
        {
            _content?.Refresh();
        }
    }

    private PtDialogContent? _content;

    internal void Attach(PtDialogContent content) => _content = content;

    internal void Detach(PtDialogContent content)
    {
        if (ReferenceEquals(_content, content))
            _content = null;
    }

    internal RenderFragment RenderBody => __builder =>
    {
        <div class="pt-dialog-body">@ChildContent</div>
        @if (Footer is not null)
        {
            <div class="pt-dialog-foot">@Footer</div>
        }
    };

    private Dictionary<string, object?> Parameters => new() { [nameof(PtDialogContent.Owner)] = this };

    private async Task ShowAsync()
    {
        string css = $"pt-dialog {(Drawer ? "pt-dialog-drawer" : "pt-dialog-center")} {Class}".Trim();
        if (Drawer)
        {
            await Dialogs.OpenSideAsync<PtDialogContent>(Title, Parameters, new SideDialogOptions
            {
                CssClass = css,
                Position = DialogPosition.Right,
                ShowMask = true,
                CloseDialogOnOverlayClick = true,
            });
        }
        else
        {
            await Dialogs.OpenAsync<PtDialogContent>(Title, Parameters, new DialogOptions
            {
                CssClass = css,
                CloseDialogOnEsc = true,
                CloseDialogOnOverlayClick = true,
            });
        }

        // Closed, by whatever means.
        _shown = false;
        bool fromHere = _closingFromHere;
        _closingFromHere = false;
        if (!fromHere && Open)
        {
            Open = false;
            await OpenChanged.InvokeAsync(false);
        }
    }

    public void Dispose()
    {
        if (!_shown)
            return;
        _closingFromHere = true;
        if (Drawer)
            Dialogs.CloseSide();
        else
            Dialogs.Close();
    }
}
