@page "/account/settings"
@attribute [Authorize]
@implements IAsyncDisposable
@inject PoTrafficApiClient Api
@inject IJSRuntime JS

<PageTitle>Settings · PoTraffic</PageTitle>

<PageHeader Title="Account settings" BackHref="/dashboard" BackLabel="Commutes" />

@*  Common settings first, everything niche behind one "Advanced" disclosure.

    The page used to give every control the same billing: density, motion, locale and
    the quota meter sat at the same level as the theme and notifications, which are
    what nearly everyone comes here for. Up top now: the theme, this device
    (notifications, install) and who you are signed in as. Folded under Advanced:
    density, motion, locale, today's usage and the extra panels. Your data stays
    last and always visible — export and delete are rare, but must never be hidden.

    Each section is its own component and error boundary, so one that throws (a bad
    quota payload, say) leaves the rest of the page usable. The wrapper div carries this
    page's CSS scope; the stylesheet reaches into the section components with ::deep. *@
<div class="pt-settings">
<RadzenCard class="pt-card-pad">
    <SectionErrorBoundary Label="the appearance settings">
    <section class="pt-settings-section">
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-3 pt-section-heading">Appearance</RadzenText>
        @* RadzenSelectBar owns the roving-tabindex keyboard model, the selected state
           and the theming. *@
        <div class="pt-settings-grid">
            <div>
                <span class="pt-settings-field-label">Theme</span>
                <RadzenSelectBar TValue="string" Value="@_theme" Change="@OnThemeChanged"
                                 Size="ButtonSize.Small" aria-label="Theme">
                    <Items>
                        <RadzenSelectBarItem Value="@("system")" Text="System" Icon="computer" />
                        <RadzenSelectBarItem Value="@("light")" Text="Light" Icon="light_mode" />
                        <RadzenSelectBarItem Value="@("dark")" Text="Dark" Icon="dark_mode" />
                    </Items>
                </RadzenSelectBar>
            </div>
            @if (_profile is not null)
            {
                <div>
                    @* The sign-in address can't be changed here, so it is text, not a
                       read-only box that looks editable. *@
                    <span class="pt-settings-field-label">Signed in as</span>
                    <p class="pt-settings-value">@_profile.Email</p>
                </div>
            }
            else if (_loading)
            {
                <div class="pt-settings-reserve" aria-hidden="true">
                    <div class="pt-skeleton-line w-30"></div>
                    <div class="pt-skeleton-line w-70 pt-mt-2"></div>
                </div>
            }
        </div>

        @* Neither of these is ours to set — the OS owns them. Reporting them explains
           why the app already looks different. The OS motion preference is a floor:
           the Motion setting can never force animation back up past it. *@
        @if (_prefersContrast || _prefersReducedMotion)
        {
            <p class="pt-settings-meta pt-mt-3">Following your device: @DevicePreferences.</p>
        }
    </section>
    </SectionErrorBoundary>

    <SectionErrorBoundary Label="this device's settings">
        <DeviceSettingsSection />
    </SectionErrorBoundary>

    <AdvancedSettingsSection Profile="_profile" Quota="_quota" Loading="_loading"
                             Density="@_density" DensityChanged="OnDensityChanged"
                             ProfileChanged="@(p => _profile = p)" />

    <SectionErrorBoundary Label="your data controls">
        <AccountDataSection />
    </SectionErrorBoundary>
</RadzenCard>
</div>

@code {
    private ProfileDto? _profile;
    private QuotaDto? _quota;
    private bool _loading = true;

    private string _theme = "system";
    private string _density = "normal";
    private bool _prefersContrast;
    private bool _prefersReducedMotion;
    private IJSObjectReference? _appearance;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profile = await Api.GetProfileAsync();
            _quota = await Api.GetQuotaAsync();
        }
        catch { /* handled by null guards */ }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _appearance = await JS.InvokeAsync<IJSObjectReference>("import", "./js/po-appearance.js");
            AppearanceState state = await _appearance.InvokeAsync<AppearanceState>("getAppearance");
            _theme = state.Theme;
            _density = state.Density;
            _prefersContrast = state.PrefersContrast;
            _prefersReducedMotion = state.PrefersReducedMotion;
            StateHasChanged();
        }
        catch
        {
            // No interop is a degraded settings panel, not a broken page — the
            // controls simply show the defaults.
        }
    }

    /// <summary>
    /// RadzenSelectBar's Change hands back the item's Value boxed as object. A null can
    /// only mean a deselect, which this bar does not offer — guard anyway rather than
    /// stamping "" onto &lt;html data-theme&gt; and losing the theme entirely.
    /// </summary>
    private async Task OnThemeChanged(object? value)
    {
        if (value?.ToString() is not { Length: > 0 } theme)
            return;

        _theme = theme;
        if (_appearance is not null)
            await _appearance.InvokeVoidAsync("setTheme", theme);
    }

    private async Task OnDensityChanged(string density)
    {
        _density = density;
        if (_appearance is not null)
            await _appearance.InvokeVoidAsync("setDensity", density);
    }

    /// <summary>"higher contrast and reduced motion (…)" — whichever the OS is asking for.</summary>
    private string DevicePreferences => string.Join(" and ", new[]
    {
        _prefersContrast ? "higher contrast" : null,
        _prefersReducedMotion ? "reduced motion, so animation stays off whatever Motion is set to" : null,
    }.Where(p => p is not null));

    /// <summary>Shape returned by <c>getAppearance</c> in po-appearance.js.</summary>
    private sealed record AppearanceState(
        string Theme,
        string Density,
        bool PrefersContrast,
        bool PrefersReducedMotion);

    public async ValueTask DisposeAsync()
    {
        if (_appearance is not null)
        {
            try { await _appearance.DisposeAsync(); } catch { /* page tearing down */ }
        }
    }
}
