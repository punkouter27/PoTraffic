@page "/routes/{RouteId:guid}"
@attribute [Authorize]
@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.Enums
@using PoTraffic.Client.Features.MonitoringWindows
@inherits PollingComponentBase
@inject PoTrafficApiClient Api
@inject NavigationManager Nav
@inject UiPreferences Prefs
@inject NotificationService Notifications

@* ──────────────────────────────────────────────────────────────────────
   Route detail — the answer, the evidence, and everything else folded away.

   This page used to stack twelve blocks: three banners, a return-trip bar, a
   three-tile snapshot, a departure scrubber, a window editor, a trend chart, a
   weekday bar chart, a heatmap, a compare prompt and a poll table. Only the
   first answered the question the app exists to answer, and three of them
   answered "when is it bad?" in three different shapes.

   Now four tabs under one header: OVERVIEW (when to leave, and today's
   samples), SCHEDULE (the monitoring window and the return trip), HEATMAP
   (all seven days in 15-minute slots) and WEATHER. The map and the weather are
   advanced panels — off until switched on in Settings — so by default the page
   is the answer, today's chart, the schedule and the week. The header carries the name,
   renameable in place, and one chip saying when the route was last checked and
   when the next check is due.

   Each card sits in its own SectionErrorBoundary: one chart that throws shows a
   one-line notice with Retry instead of blanking the page.
   ────────────────────────────────────────────────────────────────────── *@

<PageTitle>@_pageTitle · PoTraffic</PageTitle>

@if (IsFirstLoad)
{
    @* The progress line says "working"; the skeleton below it holds the page's shape —
       title, tab strip, the answer and the chart card — so the real content settles
       into place instead of shoving everything down when it lands. *@
    <PtProgressLine AriaLabel="Loading commute" />
    <div class="pt-route-skeleton" aria-busy="true" aria-label="Loading commute">
        <div class="pt-route-skeleton-head">
            <div class="pt-skeleton-line lg w-50"></div>
        </div>
        <div class="pt-route-skeleton-tabs">
            <div class="pt-skeleton-line"></div>
            <div class="pt-skeleton-line"></div>
            <div class="pt-skeleton-line"></div>
        </div>
        @* The same two-column grid the Overview tab lays out in, at the answer card's and
           the chart card's real heights. *@
        <div class="pt-route-two">
            <div class="pt-skeleton-card pt-route-skeleton-answer">
                <div class="pt-skeleton-line w-40"></div>
                <div class="pt-skeleton-line lg w-70"></div>
                <div class="pt-skeleton-line w-50"></div>
            </div>
            <div class="pt-skeleton-card pt-route-skeleton-chart">
                <div class="pt-skeleton-line w-30"></div>
            </div>
        </div>
    </div>
}
else
{
    @* The page is reached by tapping a card, and had no way back but the browser's
       own control — which a PWA in standalone display mode does not render.
       The title renames the route in place; the probe state rides the header. *@
    <PageHeader Title="@_pageTitle" BackHref="/dashboard" BackLabel="Commutes"
                TitleChanged="@(_route is null ? default : EventCallback.Factory.Create<string?>(this, OnNameChangedAsync))"
                EditValue="@_route?.Name" EditPlaceholder="e.g. Home → Work">
        <Actions>
            @* Every chart below is generated data for a sample route. The chip says so
               once, beside the title, where a three-line banner used to. *@
            @if (_route?.IsSample == true)
            {
                <span class="pt-sample-chip" title="Generated history — never probed or counted against your quota">Sample data</span>
            }
            @if (_route is not null)
            {
                <SectionErrorBoundary Label="the check status">
                <RouteProbeStatus RouteId="RouteId"
                                  LatestProbe="LatestPoll"
                                  TypicalSeconds="@_path?.TypicalDurationSeconds"
                                  Session="_activeSession"
                                  ArmedWindow="_activeWindow"
                                  Paused="@(_route is { IsSample: false, MonitoringStatus: MonitoringStatus.Paused })"
                                  OnProbeCompleted="@OnWindowSaved" />
                </SectionErrorBoundary>
            }
        </Actions>
    </PageHeader>

    <StaleBanner IsOffline="IsOffline" IsStale="IsStale" />

    @if (_route is null && _notFound)
    {
        <div class="pt-empty-state">
            <PtIcon Name="explore_off" Size="xl" Class="pt-empty-state-icon" />
            <div class="pt-empty-state-title">This commute doesn't exist</div>
            <div class="pt-empty-state-text">It may have been deleted, or the link is wrong.</div>
            <RadzenButton Text="Back to commutes" ButtonStyle="ButtonStyle.Light" Icon="arrow_back"
                          Click="@(() => Nav.NavigateTo("/dashboard"))" />
        </div>
    }
    else if (_route is null)
    {
        @* Nothing ever loaded. Rendering the sections below in this state produced a
           route header with no addresses — a bare "→" — over the words "Still
           learning this route", which reads as a fact about the commute when it is
           really a failed request. An empty answer is worse than no answer. *@
        <div class="pt-empty-state">
            <PtIcon Name="cloud_off" Size="xl" Class="pt-empty-state-icon" />
            <div class="pt-empty-state-title">Couldn't load this commute</div>
            <div class="pt-empty-state-text">
                @* Deliberately not "the server didn't respond": the same branch covers a
                   route that has since been deleted, where the server answered fine. *@
                @(IsOffline
                    ? "You're offline. This page will fill in as soon as you're back."
                    : "The request failed. Retrying automatically — the commute may also have been deleted.")
            </div>
            <RadzenButton Text="Retry now" ButtonStyle="ButtonStyle.Light" Icon="refresh"
                          Click="@RefreshAsync" />
        </div>
    }
    else
    {
    string[] tabs = TabKeys;

    @* ── ONE PAGE, FOUR TABS ──────────────────────────────────────────────
       The route page and its monitoring-window editor used to be one long stack:
       the answer, then a settings card, then the evidence. They are tabs of the
       same page now — Overview (the answer and today), Schedule (the monitoring
       window and the return trip), Heatmap (all seven days in quarter-hours) and
       Weather (what rain and snow cost) — and
       the open tab rides the URL as ?tab=, so /routes/{id} still opens the answer
       and a link can land straight on the schedule.

       Server render mode (Radzen's default) on purpose: only the open tab is in the
       DOM, so the canvas chart and the map measure a real width when they attach
       rather than the zero of a display:none panel.

       The sample has no Schedule tab — it is never probed, so a schedule form on it
       would offer something that does nothing. Weather appears only when it is
       switched on in Settings → Advanced panels. *@
    <div class="pt-route-tabs">
    <RadzenTabs SelectedIndex="@Array.IndexOf(tabs, ActiveTab)" Change="@(i => OnTabChanged(tabs, i))">
        <Tabs>
            <RadzenTabsItem Text="Overview" Icon="insights">

    @* Two columns once the content column can carry them: the answer on the left,
       the evidence on the right. Below that, one column. *@
    <div class="pt-route-two">

    <aside class="pt-route-side">

    @* ── THE ANSWER ────────────────────────────────────────────────────
       Leads with "Leave by" whenever there is a plan, because that is the question the
       app exists to answer; the day's range of durations is the supporting line. *@
    <SectionErrorBoundary Label="the summary">
    <RouteAnswerCard Route="_route" OriginStreet="@_originStreet" DestinationStreet="@_destStreet"
                     Plan="_plan" TodayPolls="_todayPolls" />
    </SectionErrorBoundary>

    </aside>

    @* ── THE EVIDENCE ──────────────────────────────────────────────────
       Today's samples, and the drive beside them when the map is switched on. *@
    <div class="pt-route-evidence">

    <div class="pt-route-evidence-top @(ShowMap ? "" : "pt-route-evidence-single")">

    @if (ShowMap)
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H3" class="pt-mb-1 pt-section-heading">The drive</RadzenText>
            <SectionErrorBoundary Label="the map">
                <RouteMap Path="_path"
                          OriginLabel="@_originStreet"
                          DestinationLabel="@_destStreet" />
            </SectionErrorBoundary>
        </RadzenCard>
    }

    <RouteTodayCard TodayPolls="_todayPolls" />

    </div>
    </div>
    </div>

            </RadzenTabsItem>

            @if (!_route.IsSample)
            {
                <RadzenTabsItem Text="Schedule" Icon="schedule">
                    <RouteScheduleCard Route="_route" Window="_activeWindow" Session="_activeSession" OnChanged="OnWindowSaved" />
                </RadzenTabsItem>
            }

            @* Always shown, for every user — the weekly pattern is core, not an extra. *@
            <RadzenTabsItem Text="Heatmap" Icon="calendar_month">
                <div class="pt-route-history">
                    <RadzenCard>
                        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-1 pt-section-heading">Your week, every 15 minutes</RadzenText>
                        <SectionErrorBoundary Label="the weekly pattern">
                            <VolatilityHeatmap Heatmap="_heatmap" />
                        </SectionErrorBoundary>
                    </RadzenCard>
                </div>
            </RadzenTabsItem>

            @* The question the heatmap provokes: some mornings are worse — were they wet?
               WeatherImpact draws nothing for a null payload, and an empty card is worse
               than none, so the card waits for the first fetch. *@
            @if (ShowWeather)
            {
                <RadzenTabsItem Text="Weather" Icon="rainy">
                    <div class="pt-route-history">
                        @if (_weatherImpact is not null)
                        {
                            <RadzenCard>
                                <SectionErrorBoundary Label="the weather impact">
                                    <WeatherImpact Impact="_weatherImpact" />
                                </SectionErrorBoundary>
                            </RadzenCard>
                        }
                        else if (_weatherFetchedAt is null)
                        {
                            @* Switched on in Settings since this page loaded: the first fetch
                               rides the next refresh. Hold the card's place meanwhile. *@
                            <div class="pt-skeleton-card pt-route-skeleton-weather" aria-busy="true" aria-label="Loading weather impact">
                                <div class="pt-skeleton-line w-50"></div>
                                <div class="pt-skeleton-line w-70"></div>
                                <div class="pt-skeleton-line w-40"></div>
                            </div>
                        }
                    </div>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
    </div>

    }
}

@code {
    [Parameter] public Guid RouteId { get; set; }

    /// <summary>
    /// The open tab — "schedule", "heatmap" or "weather"; absent (or anything unknown) is
    /// Overview. Lives in the query string so a reload, a shared link or the back button keeps it.
    /// </summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private const string OverviewTab = "overview";
    private const string ScheduleTab = "schedule";
    private const string HeatmapTab = "heatmap";
    private const string WeatherTab = "weather";

    // Advanced panels (Settings → Advanced panels). Read per render: the service caches
    // them, and a switch flipped in Settings applies the next time this page draws.
    private bool ShowMap => Prefs.IsOn(AdvancedPanel.Map);
    private bool ShowWeather => Prefs.IsOn(AdvancedPanel.Weather);

    /// <summary>The tabs this route has, in order. Their position is RadzenTabs' index.</summary>
    private string[] TabKeys =>
    [
        OverviewTab,
        .. _route?.IsSample == false ? [ScheduleTab] : Array.Empty<string>(),
        HeatmapTab,
        .. ShowWeather ? [WeatherTab] : Array.Empty<string>(),
    ];

    /// <summary>The tab to show: the query's, when this route has it; otherwise Overview.</summary>
    private string ActiveTab =>
        Tab?.ToLowerInvariant() is { } t && TabKeys.Contains(t) ? t : OverviewTab;

    /// <summary>
    /// Puts the picked tab in the URL, replacing the history entry so Back leaves the page
    /// rather than walking back through every tab. The router hands the new query back
    /// as <see cref="Tab"/>; the route itself is unchanged, so nothing reloads.
    /// </summary>
    private void OnTabChanged(string[] tabs, int index)
    {
        string key = index >= 0 && index < tabs.Length ? tabs[index] : OverviewTab;
        Nav.NavigateTo(
            Nav.GetUriWithQueryParameter("tab", key == OverviewTab ? null : key),
            replace: true);
    }

    /// <summary>The route this page is showing. Changing it reloads the page from scratch.</summary>
    protected override object? SubjectKey => RouteId;

    /// <summary>
    /// Drops everything held for the previous route. The two fetch timestamps matter most:
    /// they gate their fetches on a five-minute window, so without clearing them the weekly
    /// grid and the weather card would keep showing the route you just navigated away from.
    /// </summary>
    protected override void ResetForSubjectChange()
    {
        _notFound = false;
        _route = null;
        _path = null;
        _heatmap = null;
        _heatmapFetchedAt = null;
        _weatherImpact = null;
        _weatherFetchedAt = null;
        _todayPolls = [];
        _plan = null;
        _activeSession = null;
        _activeWindow = null;
        LatestPoll = null;
        _pageTitle = "Commute";
        _originStreet = string.Empty;
        _destStreet = string.Empty;
    }

    /// <summary>
    /// Oldest first. Every chart series is built by position from this list, so its order
    /// IS the x-axis.
    /// </summary>
    private List<PollRecordDto> _todayPolls = [];
    private DeparturePlanDto? _plan;
    private VolatilityHeatmapDto? _heatmap;
    private RoutePathDto? _path;

    private RouteDto? _route;
    private bool _notFound;
    private SessionDto? _activeSession;
    private MonitoringWindowDto? _activeWindow;

    // Title-cased street names for the header and the answer card, built once per load.
    private string _originStreet = string.Empty;
    private string _destStreet = string.Empty;
    /// <summary>
    /// Heading for the page. Two fallbacks: "Route" until the route lands so the
    /// header has something to render during the first paint, and "Route not
    /// found" once we've tried and the server said no — the bare "Route" was
    /// misleading on its own when the rest of the page is an empty state.
    /// </summary>
    private string _pageTitle = "Commute";

    /// <summary>
    /// The heatmap aggregates the route's entire history, so a single new sample can
    /// barely move it — refetching it on every 15-second refresh would be a whole-history
    /// scan per tick for a picture that changes hourly. Null until the first fetch.
    /// </summary>
    private DateTimeOffset? _heatmapFetchedAt;
    private static readonly TimeSpan HeatmapMaxAge = TimeSpan.FromMinutes(5);

    /// <summary>
    /// Weather impact is the same shape of aggregate as the heatmap — the whole history
    /// behind a picture that shifts over days, not seconds — so it rides the same cadence
    /// rather than the 15-second refresh.
    /// </summary>
    private WeatherImpactResponse? _weatherImpact;
    private DateTimeOffset? _weatherFetchedAt;
    private static readonly TimeSpan WeatherMaxAge = TimeSpan.FromMinutes(5);

    // Cached rather than derived on each read: the markup reads it several times
    // per render, and re-sorting up to 300 records each time is pure waste.
    private PollRecordDto? LatestPoll { get; set; }

    // Observer pattern — PollingComponentBase handles the timer loop
    protected override TimeSpan PollingInterval => TimeSpan.FromSeconds(15);

    private async Task OnWindowSaved()
    {
        await RefreshAsync();
        StateHasChanged();
    }

    protected override async Task LoadDataAsync()
    {
        // Failures propagate deliberately: PollingComponentBase turns them into backoff
        // and the stale banner. Swallowing them here would report every refresh as a
        // success and keep hammering an endpoint that is down.
        //
        // A commute that doesn't exist won't start existing: once the page says so, stop
        // asking. Navigating to another id resets the flag (ResetForSubjectChange).
        if (_notFound)
            return;

        int dayOfWeek = (int)DateTime.Today.DayOfWeek;
        string sinceUtc = DateTime.UtcNow.AddHours(-24).ToString("o");

        Task<RouteDto?> routeTask = LoadRouteAsync();
        Task<List<SessionDto>?> sessionsTask = Api.GetSessionsAsync(PoTraffic.Shared.Ids.RouteId.From(RouteId));
        Task<PagedResult<PollRecordDto>?> historyTask = Api.GetPollHistoryAsync(PoTraffic.Shared.Ids.RouteId.From(RouteId), 1, 300, sinceUtc);
        Task<DepartureDto?> planTask = Api.GetDepartureOptionalAsync(PoTraffic.Shared.Ids.RouteId.From(RouteId), dayOfWeek);

        Task<RoutePathDto?> pathTask = ShowMap
            ? Api.GetRoutePathOptionalAsync(PoTraffic.Shared.Ids.RouteId.From(RouteId))
            : Task.FromResult(_path);

        bool refreshHeatmap = _heatmapFetchedAt is not { } fetchedAt
            || DateTimeOffset.UtcNow - fetchedAt > HeatmapMaxAge;
        Task<VolatilityHeatmapDto?> heatmapTask = refreshHeatmap
            ? Api.GetHeatmapAsync(PoTraffic.Shared.Ids.RouteId.From(RouteId))
            : Task.FromResult(_heatmap);

        bool refreshWeather = ShowWeather
            && (_weatherFetchedAt is not { } weatherAt || DateTimeOffset.UtcNow - weatherAt > WeatherMaxAge);
        Task<WeatherImpactResponse?> weatherTask = refreshWeather
            ? Api.GetWeatherImpactAsync(PoTraffic.Shared.Ids.RouteId.From(RouteId))
            : Task.FromResult(_weatherImpact);

        await Task.WhenAll(routeTask, sessionsTask, historyTask, planTask, heatmapTask, pathTask, weatherTask);

        _path = await pathTask;

        _route = await routeTask;
        if (_route is not null)
        {
            // See RouteCard.razor — title-case at the read site so the dashboard
            // list and this header always render the same casing for the same
            // street, regardless of how the address was first entered.
            _originStreet = TextFormatting.Street(_route.OriginAddress);
            _destStreet = TextFormatting.Street(_route.DestinationAddress);
            _pageTitle = _route.Name ?? $"{_originStreet} → {_destStreet}";
            _activeWindow = _route.Windows.FirstOrDefault(w => w.IsActive);
        }
        else
        {
            // The route genuinely doesn't exist (or isn't ours). "Route" on its
            // own reads as a real heading next to the empty state, not as a
            // loading placeholder, so swap to something that pairs with the
            // "Couldn't load this commute" copy below.
            _pageTitle = "Commute not found";
        }

        // Today's active monitoring session — carries the server-computed poll schedule.
        // Sessions are keyed by the window's local date, not the UTC date, so compare
        // against the browser's local today (a US evening is already "tomorrow" in UTC).
        DateOnly today = DateOnly.FromDateTime(DateTime.Today);
        _activeSession = (await sessionsTask)?.FirstOrDefault(
            s => s.State == SessionState.Active && s.SessionDate == today);

        PagedResult<PollRecordDto>? historyResult = await historyTask;
        if (historyResult is not null)
        {
            // Newest-first off the wire is wrong for everything plotted: the trend line
            // drew today in reverse, so its x-axis ran 08:45 → 08:00 → 18:30. Sorted once
            // here rather than at each of the projections below, all of which are positional.
            List<PollRecordDto> recent = [.. historyResult.Items.OrderBy(p => p.PolledAtDateTime)];
            // The fetch is a rolling 24 h so "last checked" survives midnight, but "today"
            // means the browser's calendar day — the chart's axis is fixed at 00:00–23:59.
            _todayPolls = [.. recent.Where(p => p.PolledAtDateTime.Date == DateTime.Today)];
            LatestPoll = recent.Count > 0 ? recent[^1] : null;
        }

        _plan = (await planTask)?.Plan;

        _heatmap = await heatmapTask;
        if (refreshHeatmap)
            _heatmapFetchedAt = DateTimeOffset.UtcNow;

        _weatherImpact = await weatherTask;
        if (refreshWeather)
            _weatherFetchedAt = DateTimeOffset.UtcNow;
    }

    private async Task OnNameChangedAsync(string? name)
    {
        try
        {
            HttpResponseMessage resp = await Api.SetRouteNameAsync(PoTraffic.Shared.Ids.RouteId.From(RouteId), name);
            if (resp.IsSuccessStatusCode)
                await RefreshAsync();
        }
        catch (HttpRequestException) { /* offline — the header keeps the saved name */ }
    }

    /// <summary>
    /// Reads the departure recommendation, treating "there isn't one yet" as a value
    /// rather than an error.
    ///
    /// The endpoint answers 204 No Content until a route has enough history to
    /// recommend anything — the normal state of every route for its first few days.
    /// GetFromJsonAsync counts 204 as success and then throws parsing the empty body,
    /// and because this page deliberately lets load failures propagate (so a genuinely
    /// down endpoint produces backoff and the stale banner), that exception took the
    /// whole page down: a brand-new route showed "Couldn't load this commute — the route
    /// may also have been deleted" from the moment it was created. The page already
    /// has the right words for this state a few lines below ("Still learning this
    /// route"); it simply never got to render them.
    ///
    /// The dashboard calls the same endpoint inside a try/catch, which is why the
    /// cards were unaffected and the bug only appeared one tap deeper.
    /// </summary>
    private async Task<RouteDto?> LoadRouteAsync()
    {
        (RouteDto? route, bool notFound) = await Api.GetRouteAsync(PoTraffic.Shared.Ids.RouteId.From(RouteId));
        _notFound = notFound;
        if (_notFound)
            _pageTitle = "Commute not found";
        return route;
    }
}
