@page "/login"
@attribute [AllowAnonymous]
@using PoTraffic.Client.Layout
@inject PoTrafficApiClient Api
@inject NavigationManager Nav

<PageTitle>Sign in · PoTraffic</PageTitle>

@* Po web standard: the sign-in page shows the title and ONE "Sign in with Microsoft" button, in
   every environment. Development/Test hosts have a fake sign-in URL instead of a second button
   (GET /api/auth/guest-login?returnUrl=/dashboard, docs/development.md). An alert appears only
   when sign-in failed or Microsoft sign-in is not configured on this server. *@
<RadzenCard class="pt-p-6 auth-card-body">
    <h1 class="auth-title">PoTraffic</h1>

    @if (!string.IsNullOrEmpty(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" class="pt-mb-3">@_error</RadzenAlert>
    }

    @if (_providersLoaded && !_microsoftConfigured)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" class="pt-mb-3">
            Microsoft sign-in is not configured on this server.
        </RadzenAlert>
    }

    <RadzenButton Text="Sign in with Microsoft" ButtonStyle="ButtonStyle.Primary"
                  class="pt-w-100 auth-social-btn"
                  Click='() => StartExternalLogin("microsoft")'
                  Disabled="@(_loading || (_providersLoaded && !_microsoftConfigured))" />
</RadzenCard>

@code {
    private string _error = "";
    private bool _loading;
    private bool _providersLoaded;
    private List<string> _availableProviders = [];
    private bool _microsoftConfigured => _availableProviders.Contains("microsoft");

    protected override async Task OnInitializedAsync()
    {
        // The BFF OAuth callback redirects here with ?error=CODE on failure.
        string query = new Uri(Nav.Uri).Query;
        if (!string.IsNullOrEmpty(query))
        {
            var parsed = System.Web.HttpUtility.ParseQueryString(query);
            if (!string.IsNullOrWhiteSpace(parsed["error"]))
                _error = "Microsoft sign-in failed. Please try again.";
        }

        try
        {
            ProvidersResponse? result = await Api.GetAuthProvidersAsync();
            if (result is not null)
                _availableProviders = result.Providers;
        }
        catch
        {
            // Non-fatal — the Microsoft button stays enabled and falls back to a server-side error.
        }
        finally
        {
            _providersLoaded = true;
        }
    }

    private void StartExternalLogin(string provider)
    {
        _loading = true;
        string encodedReturnUrl = Uri.EscapeDataString("/dashboard");
        Nav.NavigateTo($"/api/auth/external/{provider}/start?returnUrl={encodedReturnUrl}", forceLoad: true);
    }
}
