@page "/dashboard"
@attribute [Authorize]
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.DTOs.Account
@using PoTraffic.Shared.Enums
@using PoTraffic.Client.Features.Routes
@inherits PollingComponentBase
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Nav
@inject ClientCache Cache
@inject PendingDeletionService Pending

@using PoTraffic.Shared.Constants

<PageTitle>Commutes — PoTraffic</PageTitle>

@* The page leads with a heading like every other route. *@

<PageHeader Title="Your commutes"
            Subtitle="@_subtitle" />

@* ONE toolbar for the list: find, narrow, order, act — in that order, on one surface.
   Search, the status filter and the sort read as a single control strip rather than
   three loose widgets; "Select" opens the bulk-actions drawer, and Add stays hidden on
   a phone, where the bottom nav's FAB is the same action under the thumb.

   Rendered during the first load as well (disabled), so the cards land under a
   toolbar that is already there instead of pushing it in above them. On an account
   with no commutes the list tools are left out — they would be controls for nothing. *@
<SectionErrorBoundary Label="the commute tools">
<div class="pt-dash-toolbar" role="toolbar" aria-label="Commute list tools">
    @if (_routes.Count > 0 || ShowSkeletons)
    {
        <div class="pt-dash-toolbar-find">
            <PtIcon Name="search" Size="sm" Class="pt-dash-search-icon" />
            @* data-shortcut="/": the "/" key focuses this (Layout/KeyboardShortcuts). *@
            <RadzenTextBox @bind-Value="_search" @bind-Value:after="RecomputeVisible" Immediate="true"
                           Placeholder="Search commutes" aria-label="Search commutes"
                           aria-keyshortcuts="/" data-shortcut="/"
                           class="pt-dash-search" autocomplete="off" Disabled="ShowSkeletons" />
        </div>
        <RadzenSelectBar TValue="StatusFilter" @bind-Value="_filter" @bind-Value:after="RecomputeVisible"
                         Size="ButtonSize.Small" aria-label="Show" Disabled="ShowSkeletons"
                         class="pt-dash-filter">
            <Items>
                <RadzenSelectBarItem Value="@StatusFilter.All" Text="All" />
                <RadzenSelectBarItem Value="@StatusFilter.Monitoring" Text="Monitoring" />
                <RadzenSelectBarItem Value="@StatusFilter.Paused" Text="Paused" />
            </Items>
        </RadzenSelectBar>
        <RadzenDropDown TValue="SortOrder" @bind-Value="_sort" @bind-Value:after="RecomputeVisible"
                        Data="@SortOptions" TextProperty="Label" ValueProperty="Value"
                        aria-label="Sort commutes" class="pt-dash-sort" Disabled="ShowSkeletons" />
        <RadzenButton Text="Select" Icon="checklist" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                      class="pt-dash-select" Disabled="@(ShowSkeletons || ShownRoutes.Count == 0)"
                      aria-haspopup="dialog" Click="OpenBulk" />
    }
    <RadzenButton Text="Add commute" Icon="add" ButtonStyle="ButtonStyle.Primary"
                  class="pt-hide-phone pt-dash-add" title="New commute (n)"
                  Click="@(() => Nav.NavigateTo("/routes/create"))" />
</div>
</SectionErrorBoundary>

@* Connectivity is the one status fact that changes how far to trust the cards, and it
   shows only when the news is bad; quota and spend live in Settings. *@
<StaleBanner IsOffline="IsOffline" IsStale="IsStale" />

@if (_quotaConsumed >= _quotaLimit - 2)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" class="pt-mb-3 pt-enter">
        Daily monitoring limit almost reached — sampling will pause once it's hit.
    </RadzenAlert>
}

@if (ShowSkeletons)
{
    @* Shimmer cards in the SAME grid the real cards use, at the real card's height, so
       the first paint is the page's final shape: two columns on a desktop, one on a
       phone, nothing moving when the data lands. Shown only when there is genuinely
       nothing to draw — a cached snapshot or a background refresh never blanks a
       populated dashboard. *@
    <div class="pt-route-cards pt-dash-skeleton" aria-busy="true" aria-label="Loading commutes">
        @for (int i = 0; i < 4; i++)
        {
            <div>
                <div class="pt-skeleton-card pt-skeleton-route-card">
                    <div class="pt-skeleton-line w-50"></div>
                    <div class="pt-skeleton-line lg w-70"></div>
                </div>
            </div>
        }
    </div>
}
else if (VisibleRoutes.Count == 0 && !_hydrated)
{
    @* Nothing loaded and nothing cached — this is a failure, not an empty account.
       Showing "No routes yet" here would tell a user their routes had vanished. *@
    <div class="pt-empty-state">
        <PtIcon Name="cloud_off" Size="xl" Class="pt-empty-state-icon" />
        <div class="pt-empty-state-title">Couldn't load your commutes</div>
        <div class="pt-empty-state-text">
            @(IsOffline ? "You're offline. We'll refresh as soon as you're back."
                        : "The server didn't respond. Retrying automatically.")
        </div>
        <RadzenButton Text="Retry now" ButtonStyle="ButtonStyle.Light" Icon="refresh"
                      Click="@RefreshAsync" />
    </div>
}
else if (VisibleRoutes.Count == 0)
{
    <DashboardEmptyState />
}
else
{
    @* One card per route, and the card is the answer.

       This was a <Virtualize>, which is incompatible with the two-column grid
       the container now becomes on a wide screen: Virtualize works by rendering
       spacer <div>s above and below the visible window, and in a grid those
       spacers are grid ITEMS — they would each claim a cell and shred the
       layout. Rendering the list outright is fine here because the dashboard
       fetches at most 100 routes (pageSize=100) and a card is a handful of
       spans; the ItemSize="120" hint it relied on had already drifted from the
       card's real height twice. *@
    @* One card per route and nothing above them. The hero that used to sit here
       promised a "next departure" the app does not model: it read a time-slot
       bucket off the optimal-departure row and counted down to it as though a
       departure had been scheduled. Nothing schedules one, so the number was an
       invention — and it gave one route a treatment none of the others could
       earn. Every route is the same card now. *@
    @if (ShownRoutes.Count == 0)
    {
        @* The toolbar filtered everything out. Said plainly, with the way back, so an
           empty grid is never mistaken for an empty account. *@
        <div class="pt-empty-state pt-empty-state-inline">
            <PtIcon Name="search_off" Size="xl" Class="pt-empty-state-icon" />
            <div class="pt-empty-state-title">No commutes match</div>
            <RadzenButton Text="Clear search and filter" ButtonStyle="ButtonStyle.Light" Icon="filter_alt_off"
                          Click="ClearFilters" />
        </div>
    }

    @* Each card is its own error boundary: one route whose payload a card cannot
       render shows a one-line notice in its slot, and the other cards carry on. *@
    <SectionErrorBoundary Label="your commutes">
    <div class="pt-route-cards pt-stagger" role="list">
        @foreach (RouteDto route in ShownRoutes)
        {
            <div role="listitem" @key="route.Id">
                <SectionErrorBoundary Label="this commute">
                    <RouteCard Route="route"
                               OptimalDeparture="@(_optimalDepartures.GetValueOrDefault(route.Id))"
                               Plan="@(_plans.GetValueOrDefault(route.Id))"
                               RecentPolls="@(_recentPolls.GetValueOrDefault(route.Id, []))"
                               OnDeleted="@RefreshAsync"
                               OnRefresh="@RefreshAsync" />
                </SectionErrorBoundary>
            </div>
        }
    </div>
    </SectionErrorBoundary>
}

<SectionErrorBoundary Label="the bulk actions">
    <BulkActionsDrawer @bind-Open="_bulkOpen" Routes="ShownRoutes" OnChanged="RefreshAsync" />
</SectionErrorBoundary>

@code {
    /// <summary>How stale a cached snapshot may be and still be worth painting on mount.</summary>
    private static readonly TimeSpan CacheMaxAge = TimeSpan.FromHours(12);

    private List<RouteDto> _routes = [];
    private Dictionary<RouteId, OptimalDepartureDto> _optimalDepartures = [];
    private Dictionary<RouteId, DeparturePlanDto> _plans = [];
    private Dictionary<RouteId, List<PollRecordDto>> _recentPolls = [];
    private int _quotaConsumed;

    /// <summary>The configured daily limit from the quota endpoint; the constant until it loads.</summary>
    private int _quotaLimit = QuotaConstants.DefaultDailyQuota;
    private bool _hydrated;

    protected override TimeSpan PollingInterval => TimeSpan.FromSeconds(60);


    /// <summary>
    /// Routes with a pending delete are hidden immediately, so the swipe feels instant
    /// while the request itself is still parked behind the undo window (#3). Cached
    /// rather than derived per read — the markup reads it several times per render.
    /// </summary>
    private List<RouteDto> VisibleRoutes { get; set; } = [];

    /// <summary>
    /// The header's supporting line. Carries the connectivity state that the permanent
    /// green "Live" chip used to occupy a whole bar to report — a healthy app says so
    /// once, quietly, next to the title. Holds a line while the first load is in flight,
    /// so the header is its final height from the first paint instead of growing a row
    /// when the count arrives.
    /// </summary>
    private string? _subtitle = "Loading your commutes…";

    /// <summary>The toolbar's status filter.</summary>
    private enum StatusFilter { All, Monitoring, Paused }

    private string _search = string.Empty;
    private StatusFilter _filter = StatusFilter.All;

    /// <summary>The toolbar's ordering. Default keeps the server's order (oldest first).</summary>
    private enum SortOrder { Default, Name, Quickest, Newest }

    private sealed record SortOption(SortOrder Value, string Label);

    private static readonly SortOption[] SortOptions =
    [
        new(SortOrder.Default, "Sort: added"),
        new(SortOrder.Newest, "Sort: newest"),
        new(SortOrder.Name, "Sort: name"),
        new(SortOrder.Quickest, "Sort: quickest"),
    ];

    private SortOrder _sort = SortOrder.Default;

    private bool _bulkOpen;

    private void OpenBulk() => _bulkOpen = true;

    /// <summary>What the card leads with: its name, else "origin → destination".</summary>
    private static string SortName(RouteDto route) => route.Name ?? $"{route.OriginAddress} {route.DestinationAddress}";

    private IEnumerable<RouteDto> Sorted(IEnumerable<RouteDto> routes) => _sort switch
    {
        SortOrder.Name => routes.OrderBy(SortName, StringComparer.CurrentCultureIgnoreCase),
        SortOrder.Newest => routes.OrderByDescending(r => r.CreatedAt),
        // Routes with no estimate yet sort last rather than first: "quickest" means a
        // known quick trip, not an unknown one.
        SortOrder.Quickest => routes.OrderBy(r => _optimalDepartures.TryGetValue(r.Id, out OptimalDepartureDto? o)
            ? o.PredictedDurationSeconds : double.MaxValue),
        _ => routes,
    };

    /// <summary>
    /// <see cref="VisibleRoutes"/> narrowed by the toolbar. Kept separate because the empty
    /// states and the subtitle are about the account ("3 of 5 monitoring"), not about
    /// whatever the search box currently says.
    /// </summary>
    private List<RouteDto> ShownRoutes { get; set; } = [];

    private void ClearFilters()
    {
        _search = string.Empty;
        _filter = StatusFilter.All;
        RecomputeVisible();
    }

    /// <summary>
    /// "Monitoring" counts the sample as such, as the card's own colour does: it has history
    /// and never shows the Paused flag.
    /// </summary>
    private static bool IsMonitoring(RouteDto route) =>
        route.MonitoringStatus == MonitoringStatus.Active || route.IsSample;

    /// <summary>A search matches the name or either address — what the card shows.</summary>
    private bool MatchesToolbar(RouteDto route)
    {
        bool monitoring = IsMonitoring(route);
        if (_filter == StatusFilter.Monitoring && !monitoring) return false;
        if (_filter == StatusFilter.Paused && monitoring) return false;

        string q = _search.Trim();
        return q.Length == 0
            || (route.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || route.OriginAddress.Contains(q, StringComparison.OrdinalIgnoreCase)
            || route.DestinationAddress.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private void RecomputeVisible()
    {
        VisibleRoutes = [.. _routes.Where(r => !Pending.IsPending(r.Id))];
        ShownRoutes = [.. Sorted(VisibleRoutes.Where(MatchesToolbar))];

        // Null, not empty — PageHeader renders the subtitle element only when there
        // is one, and an empty <p> still occupies a line.
        // Same rule as the Monitoring filter, so the count and the filter never disagree.
        int active = VisibleRoutes.Count(IsMonitoring);
        _subtitle = VisibleRoutes.Count == 0
            ? null
            : $"{active} of {VisibleRoutes.Count} monitoring · updated {LocalTimeFormatter.Clock(DateTime.Now)}";
    }

    /// <summary>
    /// Skeletons only when there is genuinely nothing to show. A cached snapshot or a
    /// background refresh must never blank a dashboard the user is already reading.
    /// </summary>
    private bool ShowSkeletons => IsFirstLoad && !_hydrated;

    protected override void OnInitialized() => Pending.Changed += OnPendingChanged;

    private void OnPendingChanged()
    {
        RecomputeVisible();
        InvokeAsync(StateHasChanged);
    }

    protected override async Task LoadDataAsync()
    {
        // First paint comes from the last snapshot, if there is one — real routes on
        // screen before the network has answered (#5).
        if (IsFirstLoad)
            await HydrateFromCacheAsync();

        string dayOfWeek = DateTime.Today.DayOfWeek.ToString();

        // The route list and the quota card are independent — one round-trip, not two.
        Task<PagedResult<RouteDto>?> routesTask =
            Http.GetFromJsonAsync("/api/routes?page=1&pageSize=100", AppJsonContext.Default.PagedResultRouteDto);
        Task<QuotaDto?> quotaTask =
            Http.GetFromJsonAsync("/api/account/quota", AppJsonContext.Default.QuotaDto);

        PagedResult<RouteDto>? result = await routesTask;
        if (result is not null)
            _routes = [.. result.Items];

        QuotaDto? quota = await quotaTask;
        if (quota is not null)
        {
            _quotaConsumed = quota.UsedToday;
            _quotaLimit = quota.DailyLimit;
        }

        // UI-2/UI-12: Load the departure answer + 24h trend for each route. Every route's
        // pair is independent of every other's, so they all go out at once — awaiting
        // them in a loop made the refresh cost the SUM of 2×N latencies every 60s.
        // Per-route failures stay non-fatal.
        Dictionary<RouteId, OptimalDepartureDto> departures = [];
        Dictionary<RouteId, DeparturePlanDto> plans = [];
        Dictionary<RouteId, List<PollRecordDto>> polls = [];
        string sinceUtc = Uri.EscapeDataString(DateTime.UtcNow.AddHours(-24).ToString("o"));

        await Task.WhenAll(_routes.Select(async route =>
        {
            try
            {
                // Routes with no active monitoring window cannot have polls yet,
                // so /departure is guaranteed to return 204 and
                // /poll-history is guaranteed to return empty. Both endpoints
                // are cheap, but on a dashboard with several freshly-created
                // routes the noise was real: every 60 s the WASM client logged
                // requestFailed / pageError and forwarded a row to
                // /api/diag/client-error.
                // The sample route is Paused by design yet carries a full generated
                // history — skipping it left its card saying "No samples yet" while its
                // own page showed a week of data.
                bool isMonitored = route.IsSample || route.Windows.Any(w => w.IsActive);

                // One call carries both the quickest slot and, with an arrive-by target, the plan.
                Task<HttpResponseMessage>? departureTask = isMonitored
                    ? Http.GetAsync($"/api/routes/{route.Id}/departure?dayOfWeek={dayOfWeek}")
                    : null;

                Task<PagedResult<PollRecordDto>?>? historyTask = isMonitored
                    ? Http.GetFromJsonAsync(
                        $"/api/routes/{route.Id}/poll-history?page=1&pageSize=60&sinceUtc={sinceUtc}", AppJsonContext.Default.PagedResultPollRecordDto)
                    : null;

                if (departureTask is not null
                    && await departureTask is { StatusCode: System.Net.HttpStatusCode.OK } departureResp
                    && await departureResp.Content.ReadFromJsonAsync(AppJsonContext.Default.DepartureDto) is { } departure)
                {
                    if (departure.Best is { } best)
                        departures[route.Id] = best;
                    if (departure.Plan is { } plan)
                        plans[route.Id] = plan;
                }

                if (historyTask is not null)
                {
                    PagedResult<PollRecordDto>? history = await historyTask;
                    if (history is not null && history.Items.Count > 0)
                        polls[route.Id] = [.. history.Items];
                }
            }
            catch
            {
                // Individual route failure doesn't break the dashboard
            }
        }));

        // Swapped in wholesale rather than cleared up front: clearing first would blank
        // every card for the duration of the fan-out.
        _optimalDepartures = departures;
        _plans = plans;
        _recentPolls = polls;
        _hydrated = true;
        RecomputeVisible();

        await PersistSnapshotAsync(quota);
    }

    /// <summary>Paints the last stored snapshot. A miss simply leaves the skeletons up.</summary>
    private async Task HydrateFromCacheAsync()
    {
        DashboardSnapshot? snapshot = await Cache.GetAsync(
            ClientCacheKeys.Dashboard, AppJsonContext.Default.DashboardSnapshot, CacheMaxAge);

        if (snapshot is null || snapshot.Routes.Count == 0)
            return;

        _routes = snapshot.Routes;
        _optimalDepartures = snapshot.Insights
            .Where(i => i.OptimalDeparture is not null)
            .ToDictionary(i => i.RouteId, i => i.OptimalDeparture!);
        _plans = snapshot.Insights
            .Where(i => i.Plan is not null)
            .ToDictionary(i => i.RouteId, i => i.Plan!);
        _recentPolls = snapshot.Insights
            .Where(i => i.RecentPolls.Count > 0)
            .ToDictionary(i => i.RouteId, i => i.RecentPolls);

        if (snapshot.Quota is { } quota)
        {
            _quotaConsumed = quota.UsedToday;
            _quotaLimit = quota.DailyLimit;
        }

        _hydrated = true;
        RecomputeVisible();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Stores the fresh payload for the next cold start and for the command palette.</summary>
    private async Task PersistSnapshotAsync(QuotaDto? quota)
    {
        List<RouteInsight> insights = [.. _routes.Select(r => new RouteInsight(
            r.Id,
            _optimalDepartures.GetValueOrDefault(r.Id),
            _recentPolls.GetValueOrDefault(r.Id, []),
            _plans.GetValueOrDefault(r.Id)))];

        await Cache.SetAsync(
            ClientCacheKeys.Dashboard,
            new DashboardSnapshot(_routes, quota, insights),
            AppJsonContext.Default.DashboardSnapshot);
    }

    public void Dispose() => Pending.Changed -= OnPendingChanged;
}
