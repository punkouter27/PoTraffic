@inject PoTrafficApiClient Api
@inject NavigationManager Nav
@inject NotificationService NotificationService

@* Settings → Your data: export and delete. Rare, but never hidden. *@
<SectionErrorBoundary Label="your data controls">
<section class="pt-settings-section pt-settings-danger">
    <RadzenText TextStyle="TextStyle.H3" class="pt-mb-3 pt-section-heading">Your data</RadzenText>
    <p class="pt-settings-meta">
        Everything PoTraffic stores about you — routes, schedules, every recorded trip and
        alert — as one JSON file. Deleting your account removes all of it permanently
        (GDPR Art. 17); it cannot be undone.
    </p>
    <div class="pt-flex pt-wrap pt-gap-2">
        @* A full navigation, not fetch: the server answers with an attachment, so the
           browser saves the file and the page stays where it is. *@
        <RadzenButton Text="Download my data" Icon="download" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                      Click="@(() => Nav.NavigateTo("/api/account/export", forceLoad: true))" />

        @* Two-stage destructive: the first tap reveals a typed-confirmation input. The
           dialog it replaced kept being closed by accident in user tests. *@
        @if (!_confirmDeleteArmed)
        {
            <RadzenButton Text="Delete my account" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                          Click="@ArmDeleteConfirmation" />
        }
    </div>
    @if (_confirmDeleteArmed)
    {
        <div class="pt-confirm-delete pt-mt-3 pt-enter">
            @* A form so Enter confirms; the field and its message are a RadzenFormField like
               every other input in the app. The button stays disabled until the phrase
               matches, so the validator only explains why. *@
            <RadzenTemplateForm TItem="DeleteConfirmForm" Data="@_deleteForm" Submit="@(_ => ConfirmDeleteAsync())">
                <RadzenFormField Text="Type DELETE to confirm" class="pt-w-100 pt-mb-2">
                    <ChildContent>
                        <RadzenTextBox Name="ConfirmPhrase" @bind-Value="_confirmDeletePhrase" Immediate="true"
                                       Placeholder="DELETE" autocomplete="off" />
                    </ChildContent>
                    <Helper>
                        <RadzenCustomValidator Component="ConfirmPhrase" Validator="@(() => _confirmDeletePhrase == "DELETE")"
                                               Text="Type DELETE in capitals, exactly." />
                    </Helper>
                </RadzenFormField>
                <div class="pt-flex pt-wrap pt-gap-2">
                    <RadzenButton ButtonType="ButtonType.Submit" Text="Confirm delete" ButtonStyle="ButtonStyle.Danger"
                                  Disabled="@(_confirmDeletePhrase != "DELETE" || _deleting)"
                                  IsBusy="@_deleting" />
                    <RadzenButton Text="Keep my account" ButtonStyle="ButtonStyle.Light"
                                  Click="@DisarmDeleteConfirmation" />
                </div>
            </RadzenTemplateForm>
        </div>
    }
</section>
</SectionErrorBoundary>

@code {
    private bool _deleting;
    private bool _confirmDeleteArmed;
    private string _confirmDeletePhrase = string.Empty;

    /// <summary>RadzenTemplateForm needs a model; the phrase is bound to component state.</summary>
    private sealed class DeleteConfirmForm { }

    private readonly DeleteConfirmForm _deleteForm = new();

    /// <summary>Reveals the typed-confirmation guard before allowing delete.</summary>
    private void ArmDeleteConfirmation()
    {
        _confirmDeleteArmed = true;
        _confirmDeletePhrase = string.Empty;
    }

    /// <summary>Closes the typed-confirmation guard without deleting.</summary>
    private void DisarmDeleteConfirmation()
    {
        _confirmDeleteArmed = false;
        _confirmDeletePhrase = string.Empty;
    }

    /// <summary>
    /// FR-031: confirm before irreversible deletion. The typed-confirmation
    /// guard (see <see cref="ArmDeleteConfirmation"/>) sits between this and the
    /// destructive button so the API only sees a request after the user has
    /// both opted in twice and typed DELETE.
    /// </summary>
    private async Task ConfirmDeleteAsync()
    {
        if (_confirmDeletePhrase != "DELETE")
            return;

        _deleting = true;
        try
        {
            HttpResponseMessage resp = await Api.DeleteAccountAsync();
            if (resp.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/login", forceLoad: true);
                return;
            }

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Account not deleted",
                Detail = $"The server refused the request ({(int)resp.StatusCode}). Nothing was removed.",
                Duration = 6000
            });
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Account not deleted",
                Detail = "Couldn't reach the server. Nothing was removed.",
                Duration = 6000
            });
        }
        finally { _deleting = false; }
    }
}
