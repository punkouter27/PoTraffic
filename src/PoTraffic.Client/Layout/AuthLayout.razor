@inherits LayoutComponentBase

@* The sign-in page (Po web standard): the shell header shows the app title only, and the page
   shows the title and one sign-in button, nothing else. *@
<PoHeader TitleOnly="true" />
<main class="auth-shell" id="main-content" tabindex="-1">
    <div class="auth-card">
        <SectionErrorBoundary Label="the sign-in form">
            @Body
        </SectionErrorBoundary>
    </div>
</main>
<RadzenNotification />
<RadzenDialog />
<RadzenTooltip />
<BuildVersion />
