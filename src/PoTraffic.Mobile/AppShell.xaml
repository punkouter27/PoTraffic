<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:PoTraffic.Mobile.Pages"
       x:Class="PoTraffic.Mobile.AppShell"
       Title="PoTraffic">

    <TabBar>
        <ShellContent Title="Commute" Route="commute" ContentTemplate="{DataTemplate pages:CommutePage}" />
        <ShellContent Title="Alerts" Route="alerts" ContentTemplate="{DataTemplate pages:AlertsPage}" />
        <ShellContent Title="Settings" Route="settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </TabBar>

</Shell>
