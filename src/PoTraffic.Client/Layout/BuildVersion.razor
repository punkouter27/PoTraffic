@using System.Reflection

@* The Po build stamp, vYYMMDD (UTC date of the HEAD commit), fixed to the bottom-right corner
   of every page by po-tokens.css (AGENTS.md standing requirement). Generated once, in
   Directory.Build.props (PoBuildStamp), into every assembly's [AssemblyMetadata("BuildVersion")],
   so server and client carry the same value. It names the build of the code actually running
   in this tab, which after a service-worker update can differ from what the server is serving.
   It is the page's <footer> (contentinfo landmark where it sits outside <main>), so no text is
   left outside a landmark (axe "region"); po-tokens.css makes it pointer-events: none. *@
@if (Stamp is not null)
{
    <footer class="po-version" title="Build @Stamp">@Stamp</footer>
}

@code {
    /// <summary>"v261118"; null only if the build somehow skipped the stamp.</summary>
    public static string? Stamp { get; } = typeof(BuildVersion).Assembly
        .GetCustomAttributes<AssemblyMetadataAttribute>()
        .FirstOrDefault(a => a.Key == "BuildVersion")?.Value is { Length: > 0 } v ? "v" + v : null;
}
