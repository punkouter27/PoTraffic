@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

@* Canvas trend chart: observed travel times, dashed baseline, shaded ±1σ band.

   #8 — hovering snaps a crosshair to the nearest sample and shows how far it sat
   from the baseline; dragging across the plot zooms into that span; clicking a
   sample raises OnPointSelected so the page can scroll the raw table to it.

   Data reaches the canvas as typed memory views through [JSImport] (FxInterop), not as
   JSON through IJSRuntime; the pointer wiring still uses IJSRuntime because it needs a
   DotNetObjectReference. Both land in the same pt-chart.js module instance. *@

@if (Points.Count == 0)
{
    <div class="pt-trend-empty">
        <PtIcon Name="show_chart" Size="xl" Class="pt-trend-empty-icon" />
        <div class="pt-trend-empty-title">No samples yet</div>
        <div class="pt-trend-empty-text">The chart will draw as soon as the first poll completes.</div>
    </div>
}
else
{
    <div class="pt-trend-host">
        <canvas @ref="_canvas" class="pt-trend-canvas" data-pt-chart="@_chartId"
                aria-label="Travel time trend chart. Drag to zoom, click a point for details."></canvas>
    </div>

    <div class="pt-trend-toolbar">
        @if (_zoom is { } zoom)
        {
            <span class="pt-trend-zoom-label">
                Zoomed to @(zoom.To - zoom.From + 1) of @Points.Count samples
            </span>
            <button type="button" class="pt-trend-zoom-reset" @onclick="() => _zoom = null">Reset zoom</button>
        }
        else
        {
            <span class="pt-trend-hint">Drag across the chart to zoom · click a point for detail</span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<double> Points { get; set; } = [];

    /// <summary>Per-sample labels shown in the hover tooltip, e.g. "08:42".</summary>
    [Parameter] public IReadOnlyList<string> Labels { get; set; } = [];

    /// <summary>
    /// Per-sample weather condition (null when not recorded). Rain, snow, storm and fog
    /// shade their span of the chart so spikes can be read against the weather.
    /// </summary>
    [Parameter] public IReadOnlyList<string?> Weather { get; set; } = [];

    /// <summary>Per-sample precipitation in mm, shown in the tooltip alongside the condition.</summary>
    [Parameter] public IReadOnlyList<double?> Precipitation { get; set; } = [];

    /// <summary>Raised with the index (into the full <see cref="Points"/> list) of a clicked sample.</summary>
    [Parameter] public EventCallback<int> OnPointSelected { get; set; }

    private ElementReference _canvas;

    /// <summary>How pt-chart.js finds this canvas on the typed path, which cannot carry an ElementReference.</summary>
    private readonly string _chartId = Guid.NewGuid().ToString("N");
    private IJSObjectReference? _module;
    private IJSObjectReference? _detach;
    private DotNetObjectReference<TrendChart>? _selfRef;
    private bool _ready;

    private (int From, int To)? _zoom;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The canvas only exists once there is data, so attachment cannot simply key
        // off firstRender — a chart that starts empty would never wire up.
        if (_ready || Points.Count == 0)
        {
            if (_ready) await RenderAsync();
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pt-chart.js");
            _selfRef = DotNetObjectReference.Create(this);
            _detach = await _module.InvokeAsync<IJSObjectReference>(
                "attach", _canvas, _selfRef, nameof(OnChartGestureAsync));
            _ready = true;
            await RenderAsync();
        }
        catch
        {
            _ready = false;
        }
    }

    protected override void OnParametersSet()
    {
        // A zoom window from a previous, longer series would slice out of range.
        if (_zoom is { } zoom && zoom.To >= Points.Count)
            _zoom = null;
    }

    [JSInvokable]
    public async Task OnChartGestureAsync(ChartGesture gesture)
    {
        switch (gesture.Kind)
        {
            case "brush":
                // Two points is the least that still draws a line; anything narrower
                // would zoom into a single dot.
                if (gesture.ToIndex - gesture.FromIndex >= 1)
                {
                    _zoom = ToFullRange(gesture.FromIndex, gesture.ToIndex);
                    // Re-render, which redraws the canvas via OnAfterRenderAsync.
                    StateHasChanged();
                }
                break;

            case "point":
                if (OnPointSelected.HasDelegate)
                {
                    (int index, _) = ToFullRange(gesture.Index, gesture.Index);
                    await OnPointSelected.InvokeAsync(index);
                }
                break;
        }
    }

    /// <summary>Maps indices in the currently rendered slice back onto the full series.</summary>
    private (int From, int To) ToFullRange(int from, int to)
    {
        int offset = _zoom?.From ?? 0;
        return (offset + from, offset + to);
    }

    private IReadOnlyList<T> Slice<T>(IReadOnlyList<T> source)
    {
        if (_zoom is not { } zoom || source.Count == 0)
            return source;

        int from = Math.Clamp(zoom.From, 0, source.Count - 1);
        int to = Math.Clamp(zoom.To, from, source.Count - 1);
        return [.. source.Skip(from).Take(to - from + 1)];
    }

    private async Task RenderAsync()
    {
        if (_module is null)
            return;

        IReadOnlyList<double> points = Slice(Points);
        IReadOnlyList<string> labels = Slice(Labels);
        IReadOnlyList<string?> weather = Slice(Weather);
        IReadOnlyList<double?> precipitation = Slice(Precipitation);

        if (OperatingSystem.IsBrowser() && await RenderTypedAsync(points, labels, weather, precipitation))
            return;

        try
        {
            await _module.InvokeVoidAsync("render", _canvas, new { points, labels, weather, precipitation });
        }
        catch
        {
            // A failed draw must not take the page down; the next tick redraws.
        }
    }

    /// <summary>
    /// The typed path: the series as a <c>Span&lt;double&gt;</c> memory view, weather as a
    /// byte code per sample, a missing precipitation reading as NaN. False when the
    /// [JSImport] module could not be used, so the caller falls back to the JSON path.
    /// </summary>
    [System.Runtime.Versioning.SupportedOSPlatform("browser")]
    private async Task<bool> RenderTypedAsync(
        IReadOnlyList<double> points,
        IReadOnlyList<string> labels,
        IReadOnlyList<string?> weather,
        IReadOnlyList<double?> precipitation)
    {
        int n = points.Count;
        double[] values = new double[n];
        double[] mm = new double[n];
        byte[] codes = new byte[n];
        string[] text = new string[n];
        for (int i = 0; i < n; i++)
        {
            values[i] = points[i];
            mm[i] = i < precipitation.Count && precipitation[i] is { } p ? p : double.NaN;
            codes[i] = i < weather.Count ? FxInterop.WeatherCode(weather[i]) : (byte)0;
            text[i] = i < labels.Count ? labels[i] : string.Empty;
        }

        try
        {
            await FxInterop.EnsureChartAsync(Nav.BaseUri);
            FxInterop.RenderChart(_chartId, values, mm, codes, text);
            return true;
        }
        catch (System.Runtime.InteropServices.JavaScript.JSException)
        {
            return false;
        }
    }

    /// <summary>Pointer gesture reported by pt-chart.js.</summary>
    public sealed record ChartGesture(string Kind, int Index, int FromIndex, int ToIndex);

    public async ValueTask DisposeAsync()
    {
        if (_detach is not null)
        {
            try { await _detach.InvokeVoidAsync("call", null); } catch { /* page tearing down */ }
            try { await _detach.DisposeAsync(); } catch { /* ignore */ }
        }
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { /* ignore */ }
        }
        _selfRef?.Dispose();
    }
}
